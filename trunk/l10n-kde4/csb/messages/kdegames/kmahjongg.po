msgid ""
"*.layout|Board Layout (*.layout)\n"
"*|All Files"
msgstr ""
"*.layout|Ùkłôd planszë (*.layout)\n"
"*|Wszëtczé lopczi"

#: Editor.cpp:309
msgid "Open Board Layout"
msgstr "Òtemkni ùkłôd planszë"

#: Editor.cpp:341 Editor.cpp:360
msgid "Save Board Layout"
msgstr "Zapiszë ùkłôd planszë"

#: Editor.cpp:348 kmahjongg.cpp:563
msgid "Only saving to local files currently supported."
msgstr "Blós zapisënk do môlowëch lopków mô terô wspiarcé."

#: Editor.cpp:357
msgid "A file with that name already exists. Do you wish to overwrite it?"
msgstr "Lopk ò taczim mionie ju je. Chcesz gò nadpisac?"

#: Editor.cpp:384
msgid "The board has been modified. Would you like to save the changes?"
msgstr "Plansza òsta zmòdifikòwónô. Chcesz zachówac zmianë?"

#: Editor.cpp:392
msgid "Save failed. Aborting operation."
msgstr "Nie darzëło sã zapisac. Òprzestanié zapisu,"

#: boardwidget.cpp:410
msgid "Undo operation done successfully."
msgstr "Òperacjô copniãcô zakùńczonô zwënégą."

#: boardwidget.cpp:414
msgid "What do you want to undo? You have done nothing!"
msgstr "Co chcesz copnąc? Jesz nick ni môsz zrobioné!"

#: boardwidget.cpp:433
msgid "Sorry, you have lost the game."
msgstr "Żôl, le môsz przerzniãté grã."

#: boardwidget.cpp:478
msgid "Demo mode. Click mousebutton to stop."
msgstr "Trib demò. Klëkni klawiszã mëszë bë zatrzëmac."

#: boardwidget.cpp:487
msgid "Now it is you again."
msgstr "Terô grasz znôù të."

#: boardwidget.cpp:510
msgid "Your computer has lost the game."
msgstr "Twój kòmpùtr przerznął grã."

#: boardwidget.cpp:605
msgid "Congratulations. You have won!"
msgstr "Gratulëjã. Môsz dobëté!"

#: boardwidget.cpp:652
msgid "Calculating new game..."
msgstr "Rëchòwanié nowi grë..."

#: boardwidget.cpp:657
msgid "Error converting board information!"
msgstr "Fela kònwertowaniégò wëdowiédzë planszë!"

#: boardwidget.cpp:683
msgid "Ready. Now it is your turn."
msgstr "Parôt. Terô twòjô rësznota."

#: boardwidget.cpp:691
msgid "Error generating new game!"
msgstr "Fela bùdowaniô nowi grë!"

#: boardwidget.cpp:854
msgid "Game over: You have no moves left."
msgstr "Kùńc grë: Nie òstało ce wicy rësznotów."

#: kmahjongg.cpp:149
msgid "New Numbered Game..."
msgstr "Nowô zrëchòwónô gra..."

#: kmahjongg.cpp:156
msgid "Shu&ffle"
msgstr "Wë&miészôj"

#: kmahjongg.cpp:160
msgid "Rotate View Counter Clockwise"
msgstr "Òbrócë pòzdrzatk procëmnie do rësznotë wskpzów zédżera"

#: kmahjongg.cpp:164
msgid "Rotate View Clockwise"
msgstr "Òbrócë pòzdrzatk zgódno z rësznotą wskôzów zédżera"

#: kmahjongg.cpp:192
msgid "Removed: 0000/0000"
msgstr "Rëmniãté: 0000/0000"

#: kmahjongg.cpp:199
msgid "Game: 000000000000000000000"
msgstr "Gra: 000000000000000000000"

#: kmahjongg.cpp:213
msgid "Time: 0:00:00"
msgstr "Czas: 0:00:00"

#: kmahjongg.cpp:219
msgid "Time: "
msgstr "CZas: "


msgid "New Game"
msgstr "Nowô gra"

#: kmahjongg.cpp:237
msgid "Enter game number:"
msgstr "Wpiszë numer grë:"

#: kmahjongg.cpp:267
msgid "General"
msgstr "Òglowé"

#: kmahjongg.cpp:268
msgid "Board layout"
msgstr "Ùkłôd planszë"

#: kmahjongg.cpp:365
msgid "You have won!"
msgstr "Môsz dobëté!"

#: kmahjongg.cpp:406
#, kde-format
msgid "Game number: %1"
msgstr "Numer grë: %1"

#: kmahjongg.cpp:416
#, kde-format
msgid "Removed: %1/%2  Combinations left: %3"
msgstr "Rëmniãté: %1/%2  Zaòstałé kòmbinacje: %3"

#: kmahjongg.cpp:482
msgid "Load Game"
msgstr "Ladowanié grë"

#: kmahjongg.cpp:494
msgid "Could not read from file. Aborting."
msgstr "Ni mòże czëtac z lopkù. Òprzestanie."

#: kmahjongg.cpp:504
msgid "File is not a KMahjongg game."
msgstr "Lopk nie je grą Mahjongg."

#: kmahjongg.cpp:517
msgid "File format not recognized."
msgstr "Fòrmat lopkù nie rozpòznóny."

#: kmahjongg.cpp:554
msgid "Save Game"
msgstr "Zapiszë grã"

#: kmahjongg.cpp:571
msgid "Could not write saved game."
msgstr "Nie mòże zapisac zapisóny grë."


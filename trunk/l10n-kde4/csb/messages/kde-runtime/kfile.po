#: fileprops.cpp:230
#, kde-format
msgid "kfile"
msgstr "kfile"

#: fileprops.cpp:231
#, kde-format
msgid "A command-line tool to read and modify metadata of files."
msgstr ""
"Nôrzãdze rézë pòlétów do czëtaniô a mòdifikòwaniô meta pòdôwków lopków."

#: fileprops.cpp:232
#, kde-format
msgid "(c) 2002, Carsten Pfeiffer"
msgstr "(c) 2002, Carsten Pfeiffer"

#: fileprops.cpp:236
#, kde-format
msgid "Carsten Pfeiffer"
msgstr "Carsten Pfeiffer"

#: fileprops.cpp:245
#, kde-format
msgid "Do not print the mimetype of the given file(s)"
msgstr "Nie wëpisujë ôrtów mime nëch lopków"

#: fileprops.cpp:247
#, kde-format
msgid "List all supported metadata keys."
msgstr "Lësta wszëtczich wspiérónëch kluczy pòdôwków meta."

#: fileprops.cpp:249
#, kde-format
msgid "List all metadata keys which have a value in the given file(s)."
msgstr ""
"Lësta wszëtczich kluczy pòdôwków meta jaczé mają wôrtnotã w dónëch lopkach."

#: fileprops.cpp:252
#, kde-format
msgid ""
"Do not print a warning when more than one file was given and they do not all "
"have the same mimetype."
msgstr ""
"Nie wëpisujë òstrzégów czej wicy jak jeden lopk òstôł pòdóny ë ni mają nëch "
"sómëch ôrtów mime."

#: fileprops.cpp:255
#, kde-format
msgid "Prints all metadata values, available in the given file(s)."
msgstr ""
"Wëpisuje wszëtczé wôrtnotë pòdôwków meta, przëstãpné w pòdónëch lopkach."

#: fileprops.cpp:257
#, kde-format
msgid ""
"Opens a KDE properties dialog to allow viewing and modifying of metadata of "
"the given file(s)"
msgstr ""
"Òtmëkô òkno swòjiznë KDE bë òbaczëc ë zmienic pòdôwczi meta pòdónëch lopków"

#: fileprops.cpp:259
#, kde-format
msgid ""
"Prints the value for 'key' of the given file(s). 'key' may also be a comma-"
"separated list of keys"
msgstr ""
"Wëpisuje wôrtotã 'key' pòdónégò lopka. 'key' mòże bëc téż lëstą kluczy "
"òddzélonëch kòmą"

#: fileprops.cpp:261
#, kde-format
msgid ""
"Attempts to set the value 'value' for the metadata key 'key' for the given "
"file(s)"
msgstr ""
"Próbùjë ùstawic wôrtnotã 'value' dlô kluczy pòdôwkó meta 'key' dlô pòdónëch "
"lopków"

#: fileprops.cpp:263
#, kde-format
msgid "The file (or a number of files) to operate on."
msgstr "Lopk (abò lëczba lopków) do òperowaniô."

#: fileprops.cpp:277
#, kde-format
msgid "No files specified"
msgstr "Nie òstôł pòdóny niżóden lopk"

#: fileprops.cpp:297
#, kde-format
msgid "Cannot determine metadata"
msgstr "Nimòże nalézc pòdôwków meta"

#: rc.cpp:28
#, no-c-format
msgid "Financial Information"
msgstr "Financowô wëdowiédzô"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 89
#: rc.cpp:32
#, no-c-format
msgid "Warn me when I visit a site that uses my financial or purchase information:"
msgstr "Òstrzéżë przed próbą wëzwëskaniô Twòjëch financowëch pòdôwków:"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 99
#. i18n: tag string
#. i18n: file kprivacysettings.ui line 135
#: rc.cpp:36
#: rc.cpp:52
#, no-c-format
msgid "For marketing or advertising purposes"
msgstr "Dlô célów marketingù a reklamë"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 106
#. i18n: tag string
#. i18n: file kprivacysettings.ui line 142
#. i18n: tag string
#. i18n: file kprivacysettings.ui line 178
#: rc.cpp:40
#: rc.cpp:56
#: rc.cpp:72
#, no-c-format
msgid "To share with other companies"
msgstr "Do wëmianë z jinëma firmama"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 116
#: rc.cpp:44
#, no-c-format
msgid "Health Information"
msgstr "Wëdowiédzô ò zdrowim"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 125
#: rc.cpp:48
#, no-c-format
msgid "Warn me when I visit a site that uses my health or medical information: "
msgstr "Òstrzéżë przed próbą wëzwëskaniô Twòjëch lékarzczëch pòdôwków: "

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 152
#: rc.cpp:60
#, no-c-format
msgid "Demographics"
msgstr "Lëdztwò"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 161
#: rc.cpp:64
#, no-c-format
msgid "Warn me when I visit a site that uses my non-personally identifiable information:"
msgstr "Òstrzéżë przed próbą wëzwëskaniô Twòjëch nieòsobistëch pòdôwków:"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 171
#: rc.cpp:68
#, no-c-format
msgid "To determine my interests, habits or general behavior"
msgstr "Do òtaksowaniô zajimnotów, zwëków abò sprôwianiô sã"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 188
#: rc.cpp:76
#, no-c-format
msgid "Warn me when I visit a site that shares my personal information with other companies"
msgstr "Òstrzérzë mie przed òdwiedzanim serwera, chtëren wëmieniwô priwatne pòdôwczi z jinëma firmama"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 195
#: rc.cpp:80
#, no-c-format
msgid "Warn me when I visit a site that does not let me know what information they have about me"
msgstr "Òstrzérzë mie przed òdwiedzanim serwera, chtëren zatacô wëdowiédzë ò zbiéranëch priwatnëch pòdôwkach"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 202
#: rc.cpp:84
#, no-c-format
msgid "Personal Information"
msgstr "Priwatne pòdôwczi"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 211
#: rc.cpp:88
#, no-c-format
msgid "Warn me when I visit a site that may contact me about other products or services:"
msgstr "Òstrzérzë mie przed òdwiedzanim serwera, chtëren przësélô wëdowiédzë ò produktach czë ùsłëżnotach:"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 221
#: rc.cpp:92
#, no-c-format
msgid "Warn me when I visit a site that may use my personal information to:"
msgstr "Òstrzérzë mie przed òdwiedzanim serwera, chtëren wëzwëzskùjë priwatne pòdôwczi do:"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 231
#: rc.cpp:96
#, no-c-format
msgid "Determine my habits, interests or general behavior"
msgstr "Do òtaksowaniô zwëków, zajimnotów abò sprôwianiô sã"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 243
#: rc.cpp:100
#, no-c-format
msgid "Via telephone"
msgstr "Przez telefón"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 250
#: rc.cpp:104
#, no-c-format
msgid "Via mail"
msgstr "Pòcztą"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 264
#: rc.cpp:108
#, no-c-format
msgid "Via email"
msgstr "Przez e-mailã"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 271
#: rc.cpp:112
#, no-c-format
msgid "And do not allow me to remove my contact information"
msgstr "Ë nie zezwòlô na rëmanié Twòjëch kòntaktowëch pòdôwków"

#. i18n: tag string
#. i18n: file sweeperdialog.ui line 16
#: rc.cpp:116
#, no-c-format
msgid "Form1"
msgstr "Form1"

#. i18n: tag string
#. i18n: file sweeperdialog.ui line 32
#: rc.cpp:120
#, no-c-format
msgid "Select &All"
msgstr "Wëbiérzë &wszëtkò"

#. i18n: tag string
#. i18n: file sweeperdialog.ui line 35
#: rc.cpp:124
#, no-c-format
msgid "Alt+A"
msgstr "Alt+A"

#. i18n: tag string
#. i18n: file sweeperdialog.ui line 42
#: rc.cpp:128
#, no-c-format
msgid "Select &None"
msgstr "Ò&dznaczë wszëtkò"

#. i18n: tag string
#. i18n: file sweeperdialog.ui line 45
#: rc.cpp:132
#, no-c-format
msgid "Alt+N"
msgstr "Alt+N"

#. i18n: tag string
#. i18n: file sweeperdialog.ui line 70
#: rc.cpp:136
#, no-c-format
msgid "&Clean Up"
msgstr "Wë&czëszczë"

#. i18n: tag string
#. i18n: file sweeperdialog.ui line 73
#: rc.cpp:140
#, no-c-format
msgid "Alt+C"
msgstr "Alt+C"

#: rc.cpp:141
msgid "Your names"
msgstr "Twòjé miona"

#: rc.cpp:142
msgid "Your emails"
msgstr "Twòji e-maile"

#: sweeper.cpp:44
msgid "Description"
msgstr "Òpisënk"

#: sweeper.cpp:54
msgid "General"
msgstr "Òglowi"

#: sweeper.cpp:55
msgid "Web Browsing"
msgstr "Przezéranié séce"

#: sweeper.cpp:60
msgid "Check all cleanup actions you would like to perform. These will be executed by pressing the button below"
msgstr "Wëbierzë elementë do wëczëszczëniô. Òstaną òne wëczëszczone pò wcësniãcym knąpë niżi"

#: sweeper.cpp:61
msgid "Immediately performs the cleanup actions selected above"
msgstr "Zarôzkù zrëszë wëbróne òperacëje czëszczëniô"

#: sweeper.cpp:142
msgid "You are deleting data that is potentially valuable to you. Are you sure?"
msgstr "Na gwës rëmac wëbróne pòdôwczi?"

#: sweeper.cpp:147
msgid "Starting cleanup..."
msgstr "Je napòczãté czëszczënié..."

#: sweeper.cpp:153
#, qt-format
msgid "Clearing %1..."
msgstr "Czëszczënié %1..."

#: sweeper.cpp:158
#, qt-format
msgid "Clearing of %1 failed: %2"
msgstr "Czëszczënié %1 nie darzëłô sã: %2"

#: sweeper.cpp:164
msgid "Clean up finished."
msgstr "Czëszczënié zakùńczoné."


msgid ""
"%1 does not appear to be an image file.\n"
"Please use files with these extensions:\n"
"%2"
msgstr ""
"%1 nie je òbrôzkã.\n"
"Proszã brëkòwac lopków z zôstnëma dodôwkama:\n"
"%2"


#: main.cpp:60
msgid "&Advanced"
msgstr "&Awansowóné"

#: main.cpp:67
msgid "Storage Media"
msgstr "Nëczi pòdôwków"

#: main.cpp:69
msgid "Storage Media Control Panel Module"
msgstr "Mòduł kònfigùracëji nëków pòdôwków"

#: main.cpp:71

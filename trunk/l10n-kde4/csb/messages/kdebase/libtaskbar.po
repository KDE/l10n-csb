msgid "modified"
msgstr "zmòdifikòwóne"

#: taskcontainer.cpp:1495
msgid "Loading application ..."
msgstr "Wladowanié programù ..."

#: taskcontainer.cpp:1559
msgid "On all desktops"
msgstr "Na wszëtczé pùltë"

#: taskcontainer.cpp:1564
#, qt-format
msgctxt "On <virtual desktop name>"
msgid "On %1"
msgstr "Na pùlcë %1"

#: taskcontainer.cpp:1570
msgid "Requesting attention"
msgstr "Wëmôgô bôczënkù"

#: taskcontainer.cpp:1576
msgid "Has unsaved changes"
msgstr "Òbjëmô niezapisóne zmiany"

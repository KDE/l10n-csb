#: PowerDevilRunner.cpp:76
msgid "Lists all power profiles and allows them to be activated"
msgstr "Lëstëje wszëtczé profile energiji ë pòzwôlô jima bëc aktiwòwónëma"

#: PowerDevilRunner.cpp:78
msgid "Lists all power saving schemes and allows them to be activated"
msgstr ""
"Lëstëje wszëtczé schémë òbszcządzaniô energiji ë pòzwôlô jima bëc "
"aktiwòwónëma"

#: PowerDevilRunner.cpp:80
msgid ""
"Lists system suspend (e.g. sleep, hibernate) options and allows them to be "
"activated"
msgstr ""
"Lëstëje òptacëje zawiészeniô systemë (np. ùspiénié, hibernacëjô) ë pòzwôlô "
"na jich aktiwacëjã"

#: PowerDevilRunner.cpp:85
msgid "Suspends the system to RAM"
msgstr "Ùspi systemã w pamiãcë RAM"

#: PowerDevilRunner.cpp:92
msgid "Suspends the system to disk"
msgstr "Ùspi systemã na cwiardim diskù"

#: PowerDevilRunner.cpp:98
msgid ""
"Lists all CPU frequency scaling policies and allows them to be activated"
msgstr ""
"Lëstëje wszëtczé pòliticzi skalowaniô czãstotlëwòtama CPU ë pòzwôlô na jich "
"aktiwacëjã"

#: PowerDevilRunner.cpp:104
#, no-c-format
msgid ""
"Lists screen brightness options or sets it to the brightness defined by :q:; "
"e.g. screen brightness 50 would dim the screen to 50% maximum brightness"
msgstr ""
"Lëstëje òptacëje widnoscë abò nastawiô widnosc zdefiniowóną przez :q:. Np. "
"widnosc ekrana 50 scemni ekran do 50% maksymalny widnoscë"

#: PowerDevilRunner.cpp:201
msgid "Suspend to RAM"
msgstr "Ùspi w pamiãcë RAM"

#: PowerDevilRunner.cpp:204
msgid "Suspend to Disk"
msgstr "Ùspi na cwiardim diskù"

#: PowerDevilRunner.cpp:234
#, kde-format
msgid "Set Profile to '%1'"
msgstr "Nastôwi profil na '%1'"

#: PowerDevilRunner.cpp:273
#, kde-format
msgid "Set CPU frequency scaling policy to '%1'"
msgstr "Nastôwi pòlitikã skalowaniô czãstotlëwòscë CPU na '%1'"

#: PowerDevilRunner.cpp:279
msgctxt "Note this is a KRunner keyword"
msgid "power scheme"
msgstr "schéma energiji"

#: PowerDevilRunner.cpp:293
#, kde-format
msgid "Set Powersaving Scheme to '%1'"
msgstr "Nastôwi schémã òbszcządzaniô energiji na '%1'"

#: PowerDevilRunner.cpp:311
#, kde-format
msgid "Set Brightness to %1"
msgstr "Nastôwi widnosc na %1"

#: PowerDevilRunner.cpp:321
msgid "Dim screen totally"
msgstr "Scemni maksymalno ekran"

#: PowerDevilRunner.cpp:329
msgid "Dim screen by half"
msgstr "Scemni ò pòłowã ekran"

#: PowerDevilRunner.cpp:337
msgid "Turn off screen"
msgstr "Wëłączë ekran"


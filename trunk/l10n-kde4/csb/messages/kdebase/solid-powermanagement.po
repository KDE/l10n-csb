msgid "Error: unsupported operation!"
msgstr "Fela: niewspierónô òperacëjô!"

#: solid-powermanagement.cpp:374
#, kde-format
msgid "Error: %1"
msgstr "Fela: %1"

#: solid-powermanagement.cpp:411
#, kde-format

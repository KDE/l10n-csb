#: configdialog.cpp:353
msgid "D&isable Actions for Windows of Type WM_CLASS"
msgstr "&Wëłączë dzejanié dlô òknów tipù WM_CLASS"

#: configdialog.cpp:358
msgid ""
"<qt>This lets you specify windows in which Klipper should not invoke "
"\"actions\". Use<br /><br /><center><b>xprop | grep WM_CLASS</b></"
"center><br />in a terminal to find out the WM_CLASS of a window. Next, click "
"on the window you want to examine. The first string it outputs after the "
"equal sign is the one you need to enter here.</qt>"
msgstr ""
"<qt>Na òptacëjô pòzwôlô òtaksowac òkna, dlô chtërnëch Klipper nie mdze "
"wëwòłiwôł \"dzejań\". Brëkùjë<br /> <b /r><center><b>xprop | grep WM_CLASS</"
"b></center> <br />w terminalu, bë nalezc wôrtosc WM_CLASS danego òkna. Zôs "
"klëkni na òknie programë, dlô chtërny chcesz wëłączëc dzejania. Napiszë tuwò "
"pierszą wôrtosc pò céchù '='. </qt>"


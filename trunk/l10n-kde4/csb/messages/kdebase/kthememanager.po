msgid "&Theme name:"
msgstr "&Miono témë:"

#: rc.cpp:75
msgid "&Author:"
msgstr "Ù&sôdzca:"

#: rc.cpp:78
msgid "&Email:"
msgstr "&E-maila:"

#: rc.cpp:81
msgid "&Homepage:"
msgstr "&Domôcô starna:"

#: rc.cpp:84
msgid "Co&mment:"
msgstr "&Dopòwiesc:"


#: kde-menu.cpp:117
msgid "Output data in UTF-8 instead of local encoding"
msgstr "Wińdzeniowi pòdôwczi w kòdowaniu UTF-8 w môl môlowégò kòdowaniô "

#: kde-menu.cpp:118
msgid ""
"Print menu-id of the menu that contains\n"
"the application"
msgstr ""
"Pòkôżë id menu, jaczé zamëkô\n"
"aplikacëjã"

#: kde-menu.cpp:119
msgid ""
"Print menu name (caption) of the menu that\n"
"contains the application"
msgstr ""
"Pòkôżë miono menu, jaczé zamëkô\n"
"aplikacëjã"

#: kde-menu.cpp:120
msgid "Highlight the entry in the menu"
msgstr "Pòdsztrichiwô element menu"

#: kde-menu.cpp:121
msgid "Do not check if sycoca database is up to date"
msgstr "Nie sprôwdzôj czej baza pòdôwków sycoca je w nônowszi wersëji"

#: kde-menu.cpp:122
msgid "The id of the menu entry to locate"
msgstr "Id elementu menu do nalézeniô"

#: kde-menu.cpp:131
msgid "You must specify an application-id such as 'kde4-konsole.desktop'"
msgstr "Nót je pòdac id aplikacëji, np. 'kde4-konsole.desktop'"

#: kde-menu.cpp:140
msgid ""
"You must specify at least one of --print-menu-id, --print-menu-name or --"
"highlight"
msgstr "Nót je pòdac przenômni jedno z --print-menu-id, --print-menu-name abò --highlight"

#: kde-menu.cpp:162
#, qt-format
msgid "No menu item '%1'."
msgstr "Nié mô elementu menu %1."

#: kde-menu.cpp:166
#, qt-format
msgid "Menu item '%1' not found in menu."
msgstr "Element menu '%1' nie je nalazłi."


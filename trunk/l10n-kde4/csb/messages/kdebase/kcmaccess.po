#: kcmaccess.cpp:237
msgid "kaccess"
msgstr "kaccess"

#: kcmaccess.cpp:237
msgid "KDE Accessibility Tool"
msgstr "Nôrzãdza pòmòce przistãpù KDE"

#: kcmaccess.cpp:239
msgid "(c) 2000, Matthias Hoelzer-Kluepfel"
msgstr "(c) 2000, Matthias Hoelzer-Kluepfel"

#: kcmaccess.cpp:241

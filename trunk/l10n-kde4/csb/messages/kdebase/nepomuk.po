#: services/storage/repository.cpp:274
msgctxt "@info - notification message"
msgid "Converting Nepomuk data to a new backend. This might take a while."
msgstr ""
"Pòdôwczi Nepomuka bãdą kònwertowóné do fòrmatu czérowników. To kąsk zbawi."

#: services/storage/repository.cpp:285
msgctxt "@info - notification message"
msgid "Rebuilding Nepomuk full text search index for new features done."
msgstr "Zbùdowanié znowa fùltekstowi szëkbë Nepomuka òstało zakùńczoné."

#: services/storage/repository.cpp:304
msgctxt "@info - notification message"
msgid ""
"Converting Nepomuk data to the new backend failed. Data may still be "
"recovered manually though."
msgstr ""
"Kònwertowanié pòdôwków Nepomuka do nowégò czérownika nie darzëło sã. "
"Pòdôwczi mòże równak zjinaczëc rãczno."

#: services/storage/repository.cpp:312
msgctxt "@info - notification message"
msgid "Successfully converted Nepomuk data to the new backend."
msgstr "Ùdałé kònwertowanié pòdôwków Nepomuka dlô nowégò czérownika."

#: services/storage/repository.cpp:375
msgctxt "@info - notification message"
msgid ""
"Rebuilding Nepomuk full text search index for new features. This will only "
"be done once and might take a while."
msgstr ""
"Zbùdowanié znowa fùltekstowi szëkbë Nepomuka dlô nowich fùnkcëjów. Na "
"zjinaka bãdze le rôz zrobionô ë mòże kąsk bawic."


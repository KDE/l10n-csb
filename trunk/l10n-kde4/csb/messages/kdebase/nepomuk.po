#: rc.cpp:30
msgid "Strigi Index Folders"
msgstr "Indeksowóny katalog dlô Strigi"

#. i18n: file: kcm/nepomukconfigwidget.ui:138
#. i18n: ectx: property (text), widget (QLabel, label)
#: rc.cpp:33
msgid ""
"Select the local folders that contain files to be indexed for fast desktop "
"searches"
msgstr ""
"Wëbierzr môlowi katalog, jaczégò lopczi mają òsta indeksowólné dlô szëkbë "
"pùltu."


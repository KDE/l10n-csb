#~ msgstr "Proszã pòdac miono brëkòwnika ë parolã"

#~ msgid "File does not exist."
#~ msgstr "Lopk nie òbstoji."

#~ msgid "Access is denied."
#~ msgstr "Przëstãp je zabroniony."

#: lock/lockdlg.cc:100
msgid "<nobr><b>The session is locked</b></nobr><br />"
msgstr "<nobr><b>Na sesëjô je zablokòwónô</b></nobr><br />"

#: lock/lockdlg.cc:101
#, kde-format
msgid "<nobr><b>The session was locked by %1</b></nobr><br />"
msgstr "<nobr><b>Na sesëjô òsta zablokòwónô przez %1</b></nobr><br />"

#: lock/lockdlg.cc:114
msgid "Unl&ock"
msgstr "Òd&blokùjë"

#: lock/lockdlg.cc:116
msgid "Sw&itch User..."
msgstr "&Przełączë brëkòwnika..."

#: lock/lockdlg.cc:187
msgid "<b>Unlocking failed</b>"
msgstr "<b>Òdblokòwanié nie darzëło sã</b>"

#: lock/lockdlg.cc:195
msgid "<b>Warning: Caps Lock on</b>"
msgstr "<b>Bôczënk: Caps Lock je włączony</b>"

#: lock/lockdlg.cc:432
#, kde-format
msgid ""
"Cannot unlock the session because the authentication system failed to work;\n"
"you must kill kscreenlocker (pid %1) manually."
msgstr ""
"Ni mòżé òdblokòwac sesëji bò felëje systema ùdowierzaniô;\n"
"je nót rãczno wëłączëc kscreenlocker (pid %1)."

#: lock/lockdlg.cc:520
msgid "&Start New Session"
msgstr "&Zrëszë nową sesëjã"

#: lock/lockdlg.cc:528
#, kde-format
msgid ""
"You have chosen to open another desktop session instead of resuming the "
"current one.\n"
"The current session will be hidden and a new login screen will be "
"displayed.\n"
"An F-key is assigned to each session; F%1 is usually assigned to the first "
"session, F%2 to the second session and so on. You can switch between "
"sessions by pressing Ctrl, Alt and the appropriate F-key at the same time. "
"Additionally, the KDE Panel and Desktop menus have actions for switching "
"between sessions."
msgstr ""
"Môsz wëbróné òtemkniãcé pòstãpny sesëji pùltu w môl dostaniô nazôd biéżny.\n"
"Biéżnô sesëjô òstanié zataconô a nowi ekran logòwaniô bãdze wëskrzëniony.\n"
"Fùnkcjowi klawisza je przepisóny dlô kòżdi sesëji: F%1 je zwëkòwò przepisóny "
"do pierszi sesëji, F%2 do drëdżi ë tak dali. Mòżesz przełączëwac sã midze "
"sesjama wcëskając Ctrl, Alt ë apartny F-klawisza w tim samym czasu. "
"Dodôwnie, panel KDE ë menu pùltu mają òptacëje przełączaniô midze sesëjama."

#: lock/lockdlg.cc:541
msgid "&Do not ask again"
msgstr "&Nie pëtôj znowa"

#: lock/lockdlg.cc:597
msgid "Session"
msgstr "Sesëjô"

#: lock/lockdlg.cc:597
msgid "Location"
msgstr "Môl"

#: lock/lockdlg.cc:625
msgctxt "session"
msgid "&Activate"
msgstr "&Aktiwùjë"

#: lock/lockdlg.cc:634
msgid "Start &New Session"
msgstr "Zrëszë &nową sesëjã"

#: lock/autologout.cc:38
msgid "<qt><nobr><b>Automatic Log Out</b></nobr></qt>"
msgstr "<qt><nobr><b>Aùtomatné wëlogòwanié</b></nobr></qt>"

#: lock/autologout.cc:39
msgid ""
"<qt>To prevent being logged out, resume using this session by moving the "
"mouse or pressing a key.</qt>"
msgstr ""
"<qt>Abë zascëgnąc wëlogòwaniu, znowi nã sesëjã rëszając mëszã abò wcëskając "
"klawiszã.</qt>"

#: lock/autologout.cc:44
msgid "Time Remaining:"
msgstr "Òstałi czas:"

#: lock/autologout.cc:77
#, kde-format
msgid "<qt><nobr>You will be automatically logged out in 1 second</nobr></qt>"
msgid_plural ""
"<qt><nobr>You will be automatically logged out in %1 seconds</nobr></qt>"
msgstr[0] "<qt><nobr>Bãdzesz aùtomatno wëlogòwóny za 1 sekùndã</nobr></qt>"
msgstr[1] "<qt><nobr>Bãdzesz aùtomatno wëlogòwóny za %1 sekùndë</nobr></qt>"
msgstr[2] "<qt><nobr>Bãdzesz aùtomatno wëlogòwóny za %1 sekùndów</nobr></qt>"

#: lock/main.cc:61
msgid "KDE Screen Locker"
msgstr "Blokada ekranu KDE"

#: lock/main.cc:62
msgid "Session Locker for KDE Workspace"
msgstr "Blokòwanié sesëji dlô robòcy òbédë KDE"

#: lock/main.cc:65
msgid "Force session locking"
msgstr "Wëmùszë zablokòwanié sesëji"

#: lock/main.cc:66
msgid "Only start screen saver"
msgstr "Startëjë le wëgaszôcz ekranu"

#: lock/main.cc:67
msgid "Only use the blank screen saver"
msgstr "Brëkùjë le pùstégò wëgaszôcza ekranu"

#: lock/main.cc:68
msgid "start with plasma unlocked for configuring"
msgstr "startëjë z òdblokòwóną dlô kònfigùracëji plasmã"

#: lock/lockprocess.cc:816
msgid "Will not lock the session, as unlocking would be impossible:\n"
msgstr "Nié blokùjë sesëji, jeżlë òdblokòwanié bãdze niemòżebné:\n"

#: lock/lockprocess.cc:820
msgid "Cannot start <i>kcheckpass</i>."
msgstr "Nié mòże zrëszëc <i>kcheckpass</i>."

#: lock/lockprocess.cc:821
msgid "<i>kcheckpass</i> is unable to operate. Possibly it is not setuid root."
msgstr ""
"<i>kcheckpass</i> nié mòże dzejac. Mòże bëc, że ni ma ùstôwionégò SetUID "
"sprôwnika."

#: lock/lockprocess.cc:884
msgid "No appropriate greeter plugin configured."
msgstr "Ni mô skònfigùrowónégò wtëkôcza przëwitënkù."


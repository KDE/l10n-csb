#: lock/autologout.cc:44
msgid "<nobr><qt><b>Automatic Log Out</b></qt><nobr>"
msgstr "<nobr><qt><b>Aùtomatné wëlogòwanié</b></qt><nobr>"

#: lock/autologout.cc:45
msgid ""
"<qt>To prevent being logged out, resume using this session by moving the "
"mouse or pressing a key.</qt>"
msgstr ""
"<qt>Abë zascëgnąc wëlogòwaniu, znowi nã sesëjã rëszając mëszã abò wcëskając "
"klawiszã.</qt>"

#: lock/autologout.cc:50
msgid "Time Remaining:"
msgstr "Òstałi czas:"

#: lock/autologout.cc:86
#, qt-format
msgid "<nobr><qt>You will be automatically logged out in 1 second</qt></nobr>"
msgid_plural ""
"<nobr><qt>You will be automatically logged out in %1 seconds</qt></nobr>"
msgstr[0] "<nobr><qt>Bãdzesz aùtomatno wëlogòwóny za 1 sekùndã</qt></nobr>"
msgstr[1] "<nobr><qt>Bãdzesz aùtomatno wëlogòwóny za %1 sekùndë</qt></nobr"
msgstr[2] "<nobr><qt>Bãdzesz aùtomatno wëlogòwóny za %1 sekùndów</qt></nobr"

#: lock/main.cc:58
msgid "Force session locking"
msgstr "Wëmùszë zablokòwanié sesëji"

#: lock/main.cc:59
msgid "Only start screensaver"
msgstr "Sztartëjë le wëgaszôcz ekranu"

#: lock/main.cc:60
msgid "Only use the blank screensaver"
msgstr "Brëkùjë le pùstégò wëgaszôcza ekranu"

#: lock/main.cc:70
msgid "KRunner Locker"
msgstr "Blokòwanié KRunner"

#: lock/main.cc:70
msgid "Session Locker for KRunner"
msgstr "Blokòwanié sesëji dlô KRunner"

#: lock/lockprocess.cc:736
msgid "Will not lock the session, as unlocking would be impossible:\n"
msgstr "Nie zablokùje sesëji, czej òdblokòwanié bãdze niemòżebné:\n"

#: lock/lockprocess.cc:740
msgid "Cannot start <i>kcheckpass</i>."
msgstr "Nie mòże zrëszëc <i>kcheckpass</i>."

#: lock/lockprocess.cc:741
msgid "<i>kcheckpass</i> is unable to operate. Possibly it is not SetUID root."
msgstr "<i>kcheckpass</i> nie mòże dzejac. Mòże bëc, że nie mô ùstôwionégò SetUID sprôwnika"

#: lock/lockprocess.cc:784
msgid "No appropriate greeter plugin configured."
msgstr "Nie mô skònfigùrowónégò pluginsa przëwitënkù."

#: lock/lockdlg.cc:96
msgid "<nobr><b>The session is locked</b><br>"
msgstr "<nobr><b>Na sesëjô je zablokòwónô</b><br>"

#: lock/lockdlg.cc:97
#, qt-format
msgid "<nobr><b>The session was locked by %1</b><br>"
msgstr "<nobr><b>Na sesëjô òsta zablokòwónô bez %1</b><br>"

#: lock/lockdlg.cc:107
msgid "Unl&ock"
msgstr "Òd&blokùjë"

#: lock/lockdlg.cc:109
msgid "Sw&itch User..."
msgstr "&Przełączë brëkòwnika..."

#: lock/lockdlg.cc:209
msgid "<b>Unlocking failed</b>"
msgstr "<b>Òdblokòwanié nie darzëło sã</b>"

#: lock/lockdlg.cc:215
msgid "<b>Warning: Caps Lock on</b>"
msgstr "<b>Bôczënk: je włączony Caps Lock</b>"

#: lock/lockdlg.cc:447
#, qt-format
msgid ""
"Cannot unlock the session because the authentication system failed to work;\n"
"you must kill krunner_lock (pid %1) manually."
msgstr ""
"Nie mòżé òdblokòwac sesëji bò systema ùdowierzaniô felëje;\n"
"mùszësz rãczno zabic (kill) krunner_lock (pid %1)."

#: lock/lockdlg.cc:561
#, qt-format
msgid ""
"You have chosen to open another desktop session instead of resuming the "
"current one.<br>The current session will be hidden and a new login screen "
"will be displayed.<br>An F-key is assigned to each session; F%1 is usually "
"assigned to the first session, F%2 to the second session and so on. You can "
"switch between sessions by pressing Ctrl, Alt and the appropriate F-key at "
"the same time. Additionally, the KDE Panel and Desktop menus have actions "
"for switching between sessions."
msgstr ""

#: lock/lockdlg.cc:574 runners/sessions/sessionrunner.cpp:111
msgid "&Start New Session"
msgstr "&Zrëszë nową sesëjã"

#: lock/lockdlg.cc:590
msgid "&Do not ask again"
msgstr "&Nie pëtôj znowa"


msgid "Home folder not available."
msgstr "Domôcy katalog nie je przistãpny."

#: kgverify.cpp:463
msgid ""
"Logins are not allowed at the moment.\n"
"Try again later."
msgstr ""
"Nie mòżesz sã terô zalogòwac.\n"
"Spróbùjë pózdze."


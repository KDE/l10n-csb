#: javascriptdataengine.cpp:93
#| msgid "i18nc() takes at least two arguments"
msgid "setData() takes at least two arguments"
msgstr "setData() mùszi miec nie mni jakno dwa argùmentë"

#: javascriptdataengine.cpp:124
#| msgid "Could not extract the AppletObject"
msgid "Could not extract the DataEngineObject"
msgstr "Ni mòże wëdobëc DataEngineObject"

#: javascriptdataengine.cpp:128
#| msgid "Could not extract the Applet"
msgid "Could not extract the DataEngine"
msgstr "Ni mòże wëdobëc DataEngine"

#: javascriptdataengine.cpp:138
#| msgid "i18n() takes at least one argument"
msgid "removeAllData() takes at least one argument (the source name)"
msgstr "removeAllData() mùszi miec ni mni jakno jeden argùment (miono zdroju)"

#: javascriptdataengine.cpp:156
#| msgid "i18nc() takes at least two arguments"
msgid "removeData() takes at least two arguments (the source and key names)"
msgstr ""
"removeData() mùszi miec ni mni jakno dwa argumentë (miona zdroju ë klucza)"

#: simplejavascriptapplet.cpp:437
msgid "dataEngine() takes one argument"
msgstr "dataEngine() mùszi miec ni mni jakno jeden argùment"

#: simplejavascriptapplet.cpp:447 simplejavascriptapplet.cpp:472
#: simplejavascriptapplet.cpp:638
msgid "Could not extract the AppletObject"
msgstr "Ni mòże wëdobëc AppletObject"

#: simplejavascriptapplet.cpp:452 simplejavascriptapplet.cpp:477
#: simplejavascriptapplet.cpp:643
msgid "Could not extract the Applet"
msgstr "Ni mòże wëdobëc Applet"

#: simplejavascriptapplet.cpp:462
msgid "service() takes two arguments"
msgstr "service() mô miec dwa argumentë"

#: simplejavascriptapplet.cpp:490
msgid "loadui() takes one argument"
msgstr "loadui() mô miec jeden argùment"

#: simplejavascriptapplet.cpp:496
#, kde-format
msgid "Unable to open '%1'"
msgstr "Ni mòże òtemknąc '%1'"

#: simplejavascriptapplet.cpp:536 simplejavascriptapplet.cpp:569
msgid "Constructor takes at least 1 argument"
msgstr "Kònstruktor mô miec conômni 1 argùment"

#: simplejavascriptapplet.cpp:620
msgid "CreateWidget takes one argument"
msgstr "CreateWidget mô miec jeden argùment"

#: simplejavascriptapplet.cpp:628
msgid "The parent must be a QGraphicsWidget"
msgstr "Rodzëcã mùszi bëc QGraphicWidget"

#: simplejavascriptapplet.cpp:678
#, kde-format
msgid "This operation was not supported, %1"
msgstr "Na òperacëjô nie je wspiérónô, %1"

#: simplejavascriptapplet.cpp:685
msgid "print() takes one argument"
msgstr "print() mô miec dwa argùmentë"

#: qtgui/linearlayout.cpp:72
msgid "LinearLayout requires a parent"
msgstr "LinearLayout wëmôgô rodzëca"

#: qtgui/linearlayout.cpp:78
msgid "The parent must be a QGraphicsLayoutItem"
msgstr "Rodzëcã mùszi bëc QGraphicsLayoutItem"


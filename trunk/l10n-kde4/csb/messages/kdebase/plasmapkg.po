#: main.cpp:42
msgid "Install, list, remove Plasma packages"
msgstr "Instalëjë, pòkażë, rëmô paczétë Plasmë"

#: main.cpp:77
msgid "Plasma Package Manager"
msgstr "Menadżera paczétów Plasmë"

#: main.cpp:79
msgid "(C) 2008, Aaron Seigo"
msgstr "(C) 2008, Aaron Seigo"

#: main.cpp:80
msgid "Aaron Seigo"
msgstr "Aaron Seigo"

#: main.cpp:81
msgid "Original author"
msgstr "Òridżinalny aùtor"

#: main.cpp:90
msgid "For install or remove, operates on packages installed for all users."
msgstr ""
"Abë winstalowac abò rëmnąc dzejôj na paczétach winstalowónëch dlô wszëtczich "
"brëkòwników."

#: main.cpp:93
msgid ""
"The type of package, e.g. theme, wallpaper, plasmoid, dataengine, runner, "
"etc."
msgstr "Ôrt paczétu, np. téma, tapéta, plasmoid, mòtór pòdôwków, runner ëtd."

#: main.cpp:97
msgctxt "Do not translate <path>"
msgid "Install the package at <path>"
msgstr "Instalëjë paczét w <path>"

#: main.cpp:99
msgctxt "Do not translate <path>"
msgid "Upgrade the package at <path>"
msgstr "Zaktualni paczét w <path>"

#: main.cpp:101
msgid "List installed packages"
msgstr "Lësta winstalowónëch paczétów"

#: main.cpp:103
msgctxt "Do not translate <name>"
msgid "Remove the package named <name>"
msgstr "Rëmô paczétë zwóné <name>"

#: main.cpp:105
msgid ""
"Absolute path to the package root. If not supplied, then the standard data "
"directories for this KDE session will be searched instead."
msgstr ""
"Bezwzglądnô stegna do spòdla paczétu. Jeżlë nie mdze wpisónô, standardowé "
"katalodżi dlô ti KDE sesëji bãdą przeszëkóne."

#: main.cpp:117
msgid "plasmoid"
msgstr "plasmoid"

#: main.cpp:121
msgid "theme"
msgstr "téma"

#: main.cpp:123
msgid "wallpaper"
msgstr "tapéta"

#: main.cpp:125
msgid "dataengine"
msgstr "mòtór pòdôwków"

#: main.cpp:129
msgid "runner"
msgstr "runner"

#: main.cpp:137
#, kde-format
msgid "Could not find a suitable installer for package of type %1"
msgstr "Ni mòże nalezc dobrégò instalownika dlô paczéta ôrtu %1"

#: main.cpp:146
#, kde-format
msgid "Could not load installer for package of type %1. Error reported was: %2"
msgstr ""
"Ni mòże wladowac instalownika dlô paczétu ôrtu %1. Zarapòrtowónô fela: %2"

#: main.cpp:202
#, kde-format
msgid "Successfully removed %1"
msgstr "Ùdało rëmniãté: %1"

#: main.cpp:204
#, kde-format
msgid "Removal of %1 failed."
msgstr "Nié ùdałé rëmniãcé: %1"

#: main.cpp:208
#, kde-format
msgid "Plugin %1 is not installed."
msgstr "Wtëkôcz %1 nie je winstalowóny."

#: main.cpp:213
#, kde-format
msgid "Successfully installed %1"
msgstr "Ùdało winstalowóné: %1"

#: main.cpp:215
#, kde-format
msgid "Installation of %1 failed."
msgstr "Nié ùdałé winstalowanié: %1"

#: main.cpp:220
msgctxt ""
"No option was given, this is the error message telling the user he needs at "
"least one, do not translate install, remove, upgrade nor list"
msgid "One of install, remove, upgrade or list is required."
msgstr ""
"Jednô òptacëjô z instalacëji, jakno rëmniãcé, zaktualnienié abò "
"wëskrzënienié je żądóné."

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "Michôł Òstrowsczi,Mark Kwidzińsczi"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "michol@linuxcsb.org,mark@linuxcsb.org"

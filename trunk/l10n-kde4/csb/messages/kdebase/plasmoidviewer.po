#: main.cpp:49
msgid "Run Plasma widgets in their own window"
msgstr "Zrëszë widżetë Plasmë w jich òknach"

#: main.cpp:100
msgid "No description available"
msgstr "Felënk przëstãpnegò òpisënka"

#: main.cpp:117
msgid "Plasma Widget Viewer"
msgstr "Przezérnik widżetów Plasmë"

#: main.cpp:119
msgid "2007-2008, Frerich Raabe"
msgstr "2007-2008, Frerich Raabe"

#: main.cpp:121
msgid "Frerich Raabe"
msgstr "Frerich Raabe"

#: main.cpp:122
msgid "Original author"
msgstr "Òridżinalny ùsôdzca"

#: main.cpp:129
msgid "Name of the containment plugin"
msgstr "Miono wtëkôcza kònténera"

#: main.cpp:131
msgctxt "Do not translate horizontal, vertical, mediacenter nor planar"
msgid "The formfactor to use (horizontal, vertical, mediacenter or planar)"
msgstr ""
"Faktor fòrmë do wëskrzënieniô (horizontal, vertical, mediacenter abò planar)"

#: main.cpp:132
msgid "Displays a list of known applets"
msgstr "Wëskrzëni lëstã znónych apletów"

#: main.cpp:133
msgid "Displays a list of known wallpapers"
msgstr "Wëskrzëni lëstã znónych spòdlëch"

#: main.cpp:134
msgid "Displays a list of known containments"
msgstr "Wëskrzëni lëstã znónych kònténerów"

#: main.cpp:136
msgctxt ""
"Do not translate floating, desktop, fullscreen, top, bottom, left nor right"
msgid ""
"The location constraint to start the Containment with (floating, desktop, "
"fullscreen, top, bottom, left, right)"
msgstr ""
"Pòłożenié z jaczim mô sztartowac kònténer (floating, desktop, fullscreen, "
"top, bottom, left, right)"

#: main.cpp:138
msgid "The size in KB to set the pixmap cache to"
msgstr "Wiôlgòsc w KB dlô pòdrãczny pamiãcë piksmapë"

#: main.cpp:140
msgid "Desktop SVG theme to use"
msgstr "Téma SVG pùltu do ùżëcô"

#: main.cpp:142
msgid ""
"Name of the wallpaper plugin. Requires a containment plugin to be specified."
msgstr "Miono wtëkôcza spòdlégò. Nót je wtëkôcza  kòntenera do specyfikacëji."

#: main.cpp:143
msgid ""
"Name of applet to view; may refer to the plugin name or be a path (absolute "
"or relative) to a package. If not provided, then an attempt is made to load "
"a package from the current directory."
msgstr ""
"Miono apleta do ùżëcô. Mòże bëc to miono wtëkacza abò stegna (wzglãdnô abò "
"bezwzglãdnô) do paczłtu. Jeżlë nie je pòdónô, tłj próbòwóné je ladowanié "
"paczétu z biéżnégò katalogù."

#: main.cpp:146
msgid "Optional arguments of the applet to add"
msgstr "Òptacëjné argùmentë apletu do dodaniô"

#: main.cpp:147
msgid "List zeroconf announced remote widgets"
msgstr "Lësta znónych ë ùprzëstãpnionych przez zeroconf widżetów"

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "Michôł Òstrowsczi,Mark Kwidzińsczi"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "michol@linuxcsb.org,mark@linuxcsb.org"


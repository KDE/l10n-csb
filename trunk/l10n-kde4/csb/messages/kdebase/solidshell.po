#: main.cpp:59
msgid "solidshell"
msgstr "solidshell"

#: main.cpp:61
msgid "KDE tool for querying and controlling your hardware from the command line"
msgstr "Nôrzãdzé KDE dlô zapëtaniów a kòntrolr twòji hard-wôrë z rézë pòlétów"

#: main.cpp:280
msgid "Syntax Error: Not enough arguments"
msgstr "Fela syntaksë: felëje argùmentów"

#: main.cpp:286
msgid "Syntax Error: Too many arguments"
msgstr "Fela syntaksë: za wiele argùmentów"

#: main.cpp:298
msgid "Show available commands by domains"
msgstr "Pòkôżë przëstãpny pòlétë pò domenach"

#: main.cpp:300
msgid "Domain (see --commands)"
msgstr "Domena (zdrzë --commands)"

#: main.cpp:302
msgid "Command (see --commands)"
msgstr "Pòlét (zdrzë --commands)"

#: main.cpp:304
msgid "Arguments for command"
msgstr "Argùmentë dlô pòlétu"

#: main.cpp:316
msgid "Syntax:"
msgstr "Syntaksa:"

#: main.cpp:319
msgid ""
"             # List the hardware available in the system.\n"
"             # - If the 'nonportableinfo' option is specified, the device\n"
"             # properties are listed (be careful, in this case property "
"names\n"
"             # are backend dependent),\n"
"             # - If the 'details' option is specified, the device "
"interfaces\n"
"             # and the corresponding properties are listed in a platform\n"
"             # neutral fashion,\n"
"             # - Otherwise only device UDIs are listed.\n"
msgstr ""
"             # Pòkôżë lëstã przëstãpnëch ùrządzeniów w systemie.\n"
"             # - czej òptacëjô 'nonportableinfo' je pòdónô, swòjiznë\n"
"             # ùrządzenié są pòdóné\n"
"             # \n"
"             # - czej pòdónô je òptacëjô 'details' interfejsë ùrządzenia\n"
"             # a sparłączoné swòjiznë są wëskrzëniwóné w neùtralnëm sztélu\n"
"             # platformë,\n"
"             # - w jinëch przëtrôfkach blós ùrządzenia UDI są wëlëstowóné.\n"

#: main.cpp:329
msgid ""
"             # Display all the interfaces and properties of the device\n"
"             # corresponding to 'udi' in a platform neutral fashion.\n"
msgstr ""
"             # Wëskrzëniwô wszëtczé interfejsë a swòjiznë ùrządzenia\n"
"             # sparłączoné z 'udi' w zwëkòwim sztélu platformë.\n"

#: main.cpp:333
msgid ""
"             # Display all the properties of the device corresponding to "
"'udi'\n"
"             # (be careful, in this case property names are backend "
"dependent).\n"
msgstr ""
"             # Wëskrzëniwô wszëtczé swòjiznë ùrządzenia sparłączone z 'udi'\n"
"             # (bôczë, że w tim przëtrôfkù, miona swòjiznów są zależne òd interfejsu).\n"

#: main.cpp:337
msgid ""
"             # List the UDI of devices corresponding to 'predicate'.\n"
"             # - If 'parentUdi' is specified, the search is restricted to "
"the\n"
"             # branch of the corresponding device,\n"
"             # - Otherwise the search is done on all the devices.\n"
msgstr ""

#: main.cpp:343
msgid "             # If applicable, mount the device corresponding to 'udi'.\n"
msgstr "             # Żelë przëstãpné, zamòntujë ùrządzenié sparłączoné z 'udi'.\n"

#: main.cpp:346
msgid "             # If applicable, unmount the device corresponding to 'udi'.\n"
msgstr "             # Żelë przëstãpné, òdmòntujë ùrządzenié sparłączoné z 'udi'.\n"

#: main.cpp:349
msgid "             # If applicable, eject the device corresponding to 'udi'.\n"
msgstr "             # Żelë przëstãpné, wëjmi ùrządzenié sparłączoné z 'udi'.\n"

#: main.cpp:356
msgid ""
"             # List a particular set of information regarding power "
"management.\n"
"             # - If the 'suspend' option is specified, give the list of "
"suspend\n"
"             # method supported by the system\n"
"             # - If the 'scheme' option is specified, give the list of\n"
"             # supported power management schemes by this system\n"
"             # - If the 'cpufreq' option is specified, give the list of\n"
"             # supported CPU frequency policy\n"
msgstr ""

#: main.cpp:365
msgid ""
"             # Set power management options of the system.\n"
"             # - If the 'scheme' option is specified, the power management\n"
"             # scheme set corresponds to 'value'\n"
"             # - If the 'cpufreq' option is specified, the CPU frequency "
"policy\n"
"             # set corresponds to 'value'\n"
msgstr ""

#: main.cpp:372
msgid "             # Suspend the computer using the given 'method'.\n"
msgstr "             # Zawiészë kòmpùtr brëkùjąc pòdóny metodë 'method'.\n"

#: main.cpp:377
msgid "             # List the network devices present.\n"
msgstr "             # Pòkôżë biéżné sécowé ùrządzenia.\n"

#: main.cpp:380
msgid "             # List the networks known to the device specified by 'uni'.\n"
msgstr "             # Pòkôżë znóné sécë dlô ùrządzeniô pòdónegò bez 'uni'.\n"

#: main.cpp:383
msgid ""
"             # Query whether networking features are active or not.\n"
"             # - If the 'status' option is given, return whether\n"
"             # networking is enabled for the system\n"
"             # - If the 'wireless' option is is given, return whether\n"
"             # wireless is enabled for the system\n"
"             # - If the 'interface' option is given, print the\n"
"             # properties of the network interface that 'uni' refers to.\n"
"             # - If the 'network' option is given, print the\n"
"             # properties of the network on 'device-uni' that 'network-uni' "
"refers to.\n"
msgstr ""

#: main.cpp:394 main.cpp:397
msgid "             # Enable or disable networking on this system.\n"
msgstr "             # Włączë abò wëłączë séc w ti systemie.\n"

#: main.cpp:400
msgid ""
"             # Activate the network 'network-uni' on 'device-uni'.\n"
"             # Optionally, use WEP128, open-system encryption with hex key "
"'key'. (Hardcoded)             # Where 'authentication' is one of:\n"
"             # wep hex64|ascii64|hex128|ascii128|passphrase64|passphrase128 "
"'key' [open|shared]\n"
"             # wpapsk wpa|wpa2 tkip|ccmp-aes password\n"
"             # wpaeap UNIMPLEMENTED IN SOLIDSHELL\n"
msgstr ""

#: main.cpp:410
msgid "             # List bluetooth adapters/interfaces\n"
msgstr "             # Pòkôżë adapter/interfejsë bluetooth\n"

#: main.cpp:413
msgid "             # List bluetooth default adapter/interface\n"
msgstr "             # Pòkôżë domëslny adapter/interfejs bluetooth\n"

#: main.cpp:416
msgid ""
"             # Query information about the bluetooth adapter/interface with "
"'ubi'\n"
msgstr "             # Òdpëtôj za adapterã/interfejsã bluetooth z 'ubi'\n"

#: main.cpp:419
msgid ""
"             # Set the bluetooth adapter name.\n"
"             # Set the bluetooth adapter mode. Where 'value' is one of:\n"
"             # off|connectable|discoverable\n"
msgstr ""

#: main.cpp:424
msgid "             # Scan for bluetooth remote devices.\n"
msgstr "             # Skanëjë za daleczima ùrządzeniama bluetooth.\n"

#: main.cpp:427
msgid "             # List configured input deviceses.\n"
msgstr "             # Pòkôżë skònfigùrowóné ùrządzenia wéńdzeniowi.\n"

#: main.cpp:430
msgid ""
"             # Setup bluetooth input device.\n"
"             # Remove configuration of remote input device.\n"
"             # Connect or disconnect bluetooth input device.\n"
msgstr ""

#: main.cpp:435
msgid ""
"             # Create bonding (pairing) with bluetooth remote device.\n"
"             # Remove bonding of bluetooth remote device.\n"
"             # Check for bonding of bluetooth remote device.\n"
msgstr ""


msgid "&Decimal symbol:"
msgstr "&Dzesątkòwi dzelôcz:"

#: localenum.cpp:58
msgid "Tho&usands separator:"
msgstr "Dzelôcz &tësąców:"

#: localenum.cpp:67
msgid "Positive si&gn:"

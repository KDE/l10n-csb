#: deviceitem.cpp:249
msgid "Click to safely remove this device from the computer."
msgstr "Klëkni bezpbezpieczno ieczno abë òdłączëc ùrządzenié òd kòmpùtra."

#: deviceitem.cpp:250
msgid "Device is plugged in and can be accessed by applications."
msgstr "Ùrządzenié je dodóné ë mòże bec brëkòwóne przez aplikacëje."

#: deviceitem.cpp:252
msgid "Click to access this device from other applications."
msgstr "Klëkni dlô przëstãpù jinszą aplikacëją do negò ùrządzenia."

#: deviceitem.cpp:253
msgid "Device is plugged in, but not mounted for access yet."
msgstr "Ùrządzenié je dodóné, równak nié zamòntowóné do przëstãpù."

#: deviceitem.cpp:344
#, kde-format
msgctxt "@info:status Free disk space"
msgid "%1 free"
msgstr "%1 wòlné"

#: devicenotifier.cpp:181
#, kde-format
msgid "1 action for this device"
msgid_plural "%1 actions for this device"
msgstr[0] "1 dzejanié dlô negò ùrządzeniô"
msgstr[1] "%1 dzejania dlô negò ùrządzeniô"
msgstr[2] "%1 dzejaniół dlô negò ùrządzeniô"

#: devicenotifier.cpp:248
msgid "No devices plugged in"
msgstr "Felëją dodóné ùrządzenia"

#: devicenotifier.cpp:252
#, kde-format
msgid "Last plugged in device: %1"
msgstr "Slédno dodóné ùrządzenié: %1"

#: devicenotifier.cpp:354
msgctxt "General options page"
msgid "General"
msgstr "Òglowò"

#: notifierdialog.cpp:65
msgid "Show hidden devices"
msgstr "Wëskrzëni zataconé ùrządzenia"

#: notifierdialog.cpp:503
msgid ""
"Could not unmount the device.\n"
"One or more files on this device are open within an application."
msgstr ""
"Nié mòże òdmòntowac ùrządzenia.\n"
"Jeden abò wicy lopków na tim ùrządzeniô je òtemkłé w aplikacëji."

#: notifierdialog.cpp:522
msgid ""
"Cannot eject the disc.\n"
"One or more files on this disc are open within an application."
msgstr ""
"Nié mòże wësënąc diskù.\n"
"Jeden abò wicy lopków na tim diskù je òtemkłi w aplikacëji."

#: notifierdialog.cpp:537
msgid "Cannot mount the disc."
msgstr "Nié mòże zamòntowac diskù."

#: notifierdialog.cpp:746
#, kde-format
msgctxt "Hide a device"
msgid "Hide %1"
msgstr "Zatacë %1"

#: notifierdialog.cpp:810
#| msgid "No devices plugged in"
msgid "No devices plugged in."
msgstr "Felëją dodóné ùrządzenia."

#: notifierdialog.cpp:812
#| msgid "<font color=\"%1\">Devices recently plugged in:</font>"
msgid "Devices recently plugged in:"
msgstr "Slédno dodóné ùrządzenia do:"


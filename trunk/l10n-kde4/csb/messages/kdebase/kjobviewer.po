msgid "All Printers"
msgstr "Wszëtczé drëkërë"

#: kjobviewer.cpp:141
msgid "There is no default printer. Start with --all to see all printers."
msgstr ""
"Nié mô domëslnëgò drëkëra. Dodôj òptacëjã --all bë òbaczëc wszëtczé drëkërë."

#: kjobviewer.cpp:141
msgid "Print Error"

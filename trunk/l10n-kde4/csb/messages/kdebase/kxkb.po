#: rc.cpp:101
msgid "Shortcuts for Switching Layout"
msgstr "Skrodzëna dlô przełączaniô ùkładów"

#. i18n: tag string
#. i18n: file kcmlayoutwidget.ui line 432
#: rc.cpp:104
msgid "Main shortcuts:"
msgstr "Przédné skrodzënë:"

#. i18n: tag string
#. i18n: file kcmlayoutwidget.ui line 442
#: rc.cpp:107
msgid ""
"This is a shortcut for switching layouts which is handled by X.org. It "
"allows modifier-only shortcuts."
msgstr ""
"To je skrodzëna dlô przełączaniô ùkładów przez X.org. Pòzwôlô blós na blós "
"zmieniwné skrodzënë."

#. i18n: tag string
#. i18n: file kcmlayoutwidget.ui line 459
#: rc.cpp:116
msgid "3rd level shortcuts:"
msgstr "Skrodzënë trzecy równi:"

#. i18n: tag string
#. i18n: file kcmlayoutwidget.ui line 469
#: rc.cpp:119
msgid ""
"This is a shortcut for switching to a third level of the active layout (if "
"it has one) which is handled by X.org. It allows modifier-only shortcuts."
msgstr ""
"To je skrodzëna dlô przełączaniô trzecy równi aktiwnégò ùkładu (jeżlë taczi "
"je) dlô X.org. Pòzwôlô blós na zmieniwné skrodzënë."

#. i18n: tag string
#. i18n: file kcmlayoutwidget.ui line 486
#: rc.cpp:128
msgid "Alternative shortcut:"
msgstr "Alternatiwnô skrodzëna:"

#. i18n: tag string
#. i18n: file kcmlayoutwidget.ui line 496
#: rc.cpp:131
msgid ""
"This is a shortcut for switching layouts which is handled by KDE. It does "
"not support modifier-only shortcuts and also may not work in some situations "
"(e.g. if popup is active or from screensaver)."
msgstr ""
"To je skrodzëna dlô przełączaniô ùkładów w KDE. Nie wspierô blós zmieniwnëch "
"skrodzënów a téż mòże nie robic w niechtërnëch lëżnoscach (np. jeżlë aktiwny "
"je popup abò w czasu dzejanégò wëgaszacza ekrana)."

#. i18n: tag string
#. i18n: file kcmlayoutwidget.ui line 523
#: rc.cpp:134
msgid "Advanced"
msgstr "Zaawansowóné"

#. i18n: tag string
#. i18n: file kcmlayoutwidget.ui line 529
#: rc.cpp:137
msgid ""
"Here you can set xkb extension options instead of, or in addition to, "
"specifying them in the X11 configuration file."
msgstr ""
"Tuwò mòżesz ùstawic òptacëje rozszérzenia xkb w môl abò dodównié do òpisania "
"jich w kònfigùracëjowim lopkù X11."

#. i18n: tag string
#. i18n: file kcmlayoutwidget.ui line 532
#: rc.cpp:140
msgid "Xkb Options"
msgstr "Òptacëje xkb"

#. i18n: tag string
#. i18n: file kcmlayoutwidget.ui line 538
#: rc.cpp:143
msgid "&Reset old options"
msgstr "&Dostóné nazôd stôré òptacëje"

#. i18n: tag string
#. i18n: file kcmlayoutwidget.ui line 562
#: rc.cpp:149
msgid ""
"This is the command which will be executed to initialize configured options."
msgstr "Nen pòlét je zrëszóny do inicjalizacji skònfigùrowónëch òptacëjów."


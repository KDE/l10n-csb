#: emoticonslist.cpp:107
msgid "Emoticons"
msgstr "Emòtikònë"

#: emoticonslist.cpp:256
msgid "Drag or Type Emoticon Theme URL"
msgstr "Wpiszë abò przëcygnie adresã témë emòtikònów"

#: emoticonslist.cpp:261
msgid "Emoticon themes must be installed from local files."
msgstr "Témë emòtikònów mùszą bëc zainstalowóné z môlowich lopków."

#: emoticonslist.cpp:262
msgid "Could Not Install Emoticon Theme"
msgstr "Ni mòże zainstalowac témë emòtikònów"

#: emoticonslist.cpp:280
#, kde-format
msgid "Do you want to remove %1 too?"
msgstr "Chesz rëmnąc téż  %1 ?"

#: emoticonslist.cpp:280
msgid "Delete emoticon"
msgstr "Rëmôj emòtikònã"

#: emoticonslist.cpp:296
msgid "Add emoticon"
msgstr "Dodôj emòtikònã"

#: emoticonslist.cpp:320
msgid "Edit emoticon"
msgstr "Editëjë emòtikònã"

#: emoticonslist.cpp:362 emoticonslist.cpp:385
msgid "New Emoticon Theme"
msgstr "Nowô téma emòtikònów"

#: emoticonslist.cpp:362
msgid "Enter the name of the new emoticon theme"
msgstr "Wpiszë miono nowi témë emòtikònów"

#: emoticonslist.cpp:368
#, kde-format
msgid "%1 theme already exists"
msgstr "Téma %1 ju òbstoji"

#: emoticonslist.cpp:385
msgid "Choose the type of emoticon theme to create"
msgstr "Wëbierzë ôrt nowi témë emòtikònów do ùsôdzeniô"

#. i18n: tag string
#. i18n: file emoticonslist.ui line 13
#: rc.cpp:3
msgid "Emoticons Manager"
msgstr "Menadżera emòtikònów"

#. i18n: tag string
#. i18n: file emoticonslist.ui line 47
#: rc.cpp:6
msgid "Create a new emoticon"
msgstr "Ùsôdzë nową emòtikònã"

#. i18n: tag string
#. i18n: file emoticonslist.ui line 50
#: rc.cpp:9
msgid "Create a new emoticon by assigning it an icon and some text"
msgstr "Ùsôdzë nową emòtikònã dodając ji ikònã ë jaczi tekst"

#. i18n: tag string
#. i18n: file emoticonslist.ui line 53
#: rc.cpp:12
msgid "Add..."
msgstr "Dodôj..."

#. i18n: tag string
#. i18n: file emoticonslist.ui line 60
#: rc.cpp:15
msgid "Modify the selected emoticon icon or text "
msgstr "Zdmòdifikùjë ikònã abò tekst wëbróny emòtikònë "

#. i18n: tag string
#. i18n: file emoticonslist.ui line 63
#: rc.cpp:18
msgid "Edit the selected emoticon to change its icon or its text"
msgstr "Editëjë wëbróną emòtikònã bë zmienic ji ikònã abò tekst"

#. i18n: tag string
#. i18n: file emoticonslist.ui line 66
#: rc.cpp:21
msgid "Edit..."
msgstr "Editëjë..."

#. i18n: tag string
#. i18n: file emoticonslist.ui line 73
#: rc.cpp:24
msgid "Remove the selected emoticon"
msgstr "Rëmôj wëbróną emòtikònã"

#. i18n: tag string
#. i18n: file emoticonslist.ui line 76
#: rc.cpp:27
msgid "Remove the selected emoticon from your disk"
msgstr "Rëmôj wëbróną emòtikònã z diskù"

#. i18n: tag string
#. i18n: file emoticonslist.ui line 79
#: rc.cpp:30
msgid "Remove"
msgstr "Rëmôj"

#. i18n: tag string
#. i18n: file emoticonslist.ui line 103
#: rc.cpp:33
msgid "Require spaces around emoticons"
msgstr "Zdefiniëjë plac wkół emòtikònczi"

#. i18n: tag string
#. i18n: file emoticonslist.ui line 110
#: rc.cpp:36
msgid "Design a new emoticon theme"
msgstr "Zabédëjë nową témã emòtikònów"

#. i18n: tag string
#. i18n: file emoticonslist.ui line 113
#: rc.cpp:39
msgid ""
"Start a new theme by assigning it a name. Then use the Add button on the "
"right to add emoticons to this theme."
msgstr ""
"Zaczni nową témã przez dodanié ji miona. Téj ùżëjë knãpë Dodôj z prawa bë "
"dodac emòtikònë do ti témë."

#. i18n: tag string
#. i18n: file emoticonslist.ui line 116
#: rc.cpp:42
msgid "New Theme..."
msgstr "Nowô téma..."

#. i18n: tag string
#. i18n: file emoticonslist.ui line 123
#: rc.cpp:45
msgid "Get new themes from the Internet"
msgstr "Zladëjë nowé témë z jinterneta"

#. i18n: tag string
#. i18n: file emoticonslist.ui line 126
#: rc.cpp:48
msgid ""
"You need to be connected to the Internet to use this action. A dialog will "
"display a list of emoticon themes from the http://www.kde.org website. "
"Clicking the Install button associated with a theme will install this theme "
"locally."
msgstr ""
"Nót je bëc pòdłączonym do jinterneta bë ùżëc ti akcëji. Dialogòwi òkno "
"pòkaże lëstã témów emòtikònów ze starnë http://www.kde.org. Klëkni na knąpã "
"Instalëjë sparłączoną z témą bë zainstalowac ją na kòmpùtrze."

#. i18n: tag string
#. i18n: file emoticonslist.ui line 129
#: rc.cpp:51
msgid "Get New Themes..."
msgstr "Zladëjë nowé témë..."

#. i18n: tag string
#. i18n: file emoticonslist.ui line 136
#: rc.cpp:54
msgid "Install a theme archive file you already have locally"
msgstr "Instalëjë lopk z témą jaką môsz ju na swòjim kòmpùtrze"

#. i18n: tag string
#. i18n: file emoticonslist.ui line 139
#: rc.cpp:57
msgid ""
"If you already have an emoticon theme archive locally, this button will "
"unpack it and make it available for KDE applications"
msgstr ""
"Jeżlë môs zju zladowóną témã, dzãka ti knąpie rozpakùjesz ją ë zrobisz "
"przëstãpną dlô aplikacëjów KDE"

#. i18n: tag string
#. i18n: file emoticonslist.ui line 142
#: rc.cpp:60
msgid "Install Theme File..."
msgstr "Instalëjë lopk témë..."

#. i18n: tag string
#. i18n: file emoticonslist.ui line 149
#: rc.cpp:63
msgid "Remove the selected theme from your disk"
msgstr "Rëmôj wëbróną témã z diskù"

#. i18n: tag string
#. i18n: file emoticonslist.ui line 152
#: rc.cpp:66
msgid "This will remove the selected theme from your disk."
msgstr "Rëmp wëbróną témã z diskù."

#. i18n: tag string
#. i18n: file emoticonslist.ui line 155
#: rc.cpp:69
msgid "Remove Theme"
msgstr "Rëmôj témã"

#: rc.cpp:70
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "Michôł Òstrowsczi"

#: rc.cpp:71
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "michol@linuxcsb.org"

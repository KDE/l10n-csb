#: solid-hardware.cpp:45
msgid "solid-hardware"
msgstr "solid-hardware"

#: solid-hardware.cpp:47
msgid "KDE tool for querying your hardware from the command line"
msgstr "Nôrzãdze KDE dlô zapëtaniów a kòntrolë twòji hardwôrë z rézë pòlétów"

#: solid-hardware.cpp:165
msgid "Syntax Error: Not enough arguments"
msgstr "Fela syntaksë: felëje argùmentów"

#: solid-hardware.cpp:170
msgid "Syntax Error: Too many arguments"
msgstr "Fela syntaksë: za wiele argùmentów"

#: solid-hardware.cpp:181
msgid "Show available commands"
msgstr "Pòkôżë przëstãpné pòlétë"

#: solid-hardware.cpp:183
msgid "Command (see --commands)"
msgstr "Pòlét (zdrzë --commands)"

#: solid-hardware.cpp:185
msgid "Arguments for command"
msgstr "Argùmentë dlô pòlétu"

#: solid-hardware.cpp:197
msgid "Syntax:"
msgstr "Syntaksa:"

#: solid-hardware.cpp:200
msgid ""
"             # List the hardware available in the system.\n"
"             # - If the 'nonportableinfo' option is specified, the device\n"
"             # properties are listed (be careful, in this case property "
"names\n"
"             # are backend dependent),\n"
"             # - If the 'details' option is specified, the device "
"interfaces\n"
"             # and the corresponding properties are listed in a platform\n"
"             # neutral fashion,\n"
"             # - Otherwise only device UDIs are listed.\n"
msgstr ""
"             # Pòkôżë lëstã przëstãpnëch ùrządzeniów w systemie.\n"
"             # - czej òptacëjô 'nonportableinfo' je pòdónô, swòjiznë\n"
"             # ùrządzenié są pòdóné\n"
"             # \n"
"             # - czej pòdónô je òptacëjô 'details' interfejsë ùrządzenia\n"
"             # a sparłączoné swòjiznë są wëskrzëniwóné w neùtralnëm sztélu\n"
"             # platformë,\n"
"             # - w jinëch przëtrôfkach blós ùrządzenia UDI są wëlëstowóné.\n"

#: solid-hardware.cpp:210
msgid ""
"             # Display all the interfaces and properties of the device\n"
"             # corresponding to 'udi' in a platform neutral fashion.\n"
msgstr ""
"             # Wëskrzëniwô wszëtczé interfejsë a swòjiznë ùrządzenia\n"
"             # sparłączoné z 'udi' w zwëkòwim sztélu platformë.\n"

#: solid-hardware.cpp:214
msgid ""
"             # Display all the properties of the device corresponding to "
"'udi'\n"
"             # (be careful, in this case property names are backend "
"dependent).\n"
msgstr ""
"             # Wëskrzëniwô wszëtczé swòjiznë ùrządzenia sparłączone z 'udi'\n"
"             # (bôczë, że w tim przëtrôfkù, miona swòjiznów są zależne òd "
"interfejsu).\n"

#: solid-hardware.cpp:218
msgid ""
"             # List the UDI of devices corresponding to 'predicate'.\n"
"             # - If 'parentUdi' is specified, the search is restricted to "
"the\n"
"             # branch of the corresponding device,\n"
"             # - Otherwise the search is done on all the devices.\n"
msgstr ""

#: solid-hardware.cpp:224
msgid ""
"             # If applicable, mount the device corresponding to 'udi'.\n"
msgstr ""
"             # Jeżlë przëstãpné, zamòntujë ùrządzenié sparłączoné z 'udi'.\n"

#: solid-hardware.cpp:227
msgid ""
"             # If applicable, unmount the device corresponding to 'udi'.\n"
msgstr ""
"             # Jeżlë przëstãpné, òdmòntujë ùrządzenié sparłączoné z 'udi'.\n"

#: solid-hardware.cpp:230
msgid ""
"             # If applicable, eject the device corresponding to 'udi'.\n"
msgstr ""
"             # Jeżlë przëstãpné, wëjmi ùrządzenié sparłączoné z 'udi'.\n"

#: solid-hardware.cpp:301
#, kde-format
msgid "Syntax Error: Unknown command '%1'"
msgstr "Fela syntaksë: Nieznóny pòlét '%1'"

#: solid-hardware.cpp:371
#, kde-format
msgid "Error: %1 does not have the interface StorageAccess."
msgstr "Fela: %1 ni mô interfejsu StorageAccess."

#: solid-hardware.cpp:376
#, kde-format
msgid "Error: %1 does not have the interface OpticalDrive."
msgstr "Fela: %1 ni mô interfejsu OpticalDrive."

#: solid-hardware.cpp:409
#, kde-format
msgid "Error: %1"
msgstr "Fela: %1"

#: solid-hardware.cpp:429
#, kde-format
msgid "Progress: %1%"
msgstr "Pòkrok: %1%"

#: solid-hardware.cpp:435
#, kde-format
msgid "Info: %1"
msgstr "Wëdowiédzô: %1"

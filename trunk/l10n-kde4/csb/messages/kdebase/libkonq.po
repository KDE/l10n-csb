#: konq_undo.cc:698
#, qt-format
msgid ""
"The file %1 was copied from %2, but since then it has apparently been "
"modified at %3.\n"
"Undoing the copy will delete the file, and all modifications will be lost.\n"
"Are you sure you want to delete %4?"
msgstr ""
"Lopk %1 òstôł skòpiérowóné z %2, leno òd tegò sztërkù òstôł zmienioné przez %"
"3.\n"
"Copając kòpiérowanié rëmnié lopk ë jegò zmianë òstaną cësniãté.\n"
"Chcesz rëmnąc %4?"

#: konq_undo.cc:701
msgid "Undo File Copy Confirmation"
msgstr "Copni pòcwierdzenie kòpiérowaniô lopków"


#: desktop.cc:815
msgid ""
"Could not log out properly.\n"
"The session manager cannot be contacted. You can try to force a shutdown by "
"pressing Ctrl+Alt+Backspace; note, however, that your current session will "
"not be saved with a forced shutdown."
msgstr ""
"Nie je mòżno sã pòprôwno wëlogòwac.\n"
"Menadżer sesëji nie òdpòwiôdô. Je mòżno wëmùszëc zamkniãce wcëskając "
"klawisze Ctrl+Alt+Backspace. Proszã pamiãtac ò tim, że nastôw biéżny sesëji "
"nie bãdze zapisóny."

#: init.cc:69
#, qt-format
msgid ""
"%1 is a file, but KDE needs it to be a directory; move it to %2.orig and "
"create directory?"
msgstr ""
"%1 je lopkã, leno KDE żądô bë to béł katalog. Zmienic miono lopkù na %2.orig "
"ë ùsôdzëc katalog?"

#: init.cc:69

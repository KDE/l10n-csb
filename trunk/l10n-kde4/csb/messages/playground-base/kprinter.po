#: main.cpp:29
#, kde-format
msgid "KPrinter"
msgstr "KPrinter"

#: main.cpp:29
#, kde-format
msgid "A printer tool for KDE"
msgstr "Nôrzãdze drëkòwaniô dlô KDE"

#: main.cpp:32
#, kde-format
msgid "Make an internal copy of the files to print"
msgstr "Zrobi bënową kòpijã drëkòwònëch lopków"

#: main.cpp:34
#, kde-format
msgid "Printer/destination to print on"
msgstr "Ùmëslny drëkër"

#: main.cpp:36
#, kde-format
msgid "Title/Name for the print job"
msgstr "Titel/miono robòtë drëkù"

#: main.cpp:38
#, kde-format
msgid "Number of copies"
msgstr "Lëczba kòpijów"

#: main.cpp:39
#, kde-format
msgid "Printer option"
msgstr "Òptacëje drëkëra"

#: main.cpp:40
#, kde-format
msgid "Job output mode (gui, console, none)"
msgstr ""
"Ôrt wińdzeniowi robòtë (\"gui\" - graficzny interfejs, \"console\" - "
"terminal, \"none\" - felënk)"

#: main.cpp:41
#, kde-format
msgid "Print system to use (lpd, cups)"
msgstr "Systema drëkù (lpd, cups)"

#: main.cpp:42
#, kde-format
msgid "Allow printing from STDIN"
msgstr "Pòzwòlë na drëk ze sztandardowégò wińdzeniô (STDIN)"

#: main.cpp:43
#, kde-format
msgid "Do not show the print dialog (print directly)"
msgstr "Nie wëskrzëniwôj òkna wëdrëkù (drëkùjë direktno)"

#: main.cpp:44
#, kde-format
msgid "Files to load"
msgstr "Lopczi do wladnowaniô"

#: printwrapper.cpp:63
#, kde-format
msgid "Print Information"
msgstr "Wëdowiédzô"

#: printwrapper.cpp:64
#, kde-format
msgid "Print Warning"
msgstr "Òstrzéga"

#: printwrapper.cpp:65
#, kde-format
msgid "Print Error"
msgstr "Fela drëkù"

#: printwrapper.cpp:71
#, kde-format
msgid "Print info"
msgstr "Wëdowiédzô"

#: printwrapper.cpp:71
#, kde-format
msgid "Print warning"
msgstr "Òstrzéga"

#: printwrapper.cpp:71
#, kde-format
msgid "Print error"
msgstr "Fela drëkù"

#: printwrapper.cpp:187
#, kde-format
msgid ""
"A file has been specified on the command line. Printing from STDIN will be "
"disabled."
msgstr ""
"W réze pòlétów pòdóny je lopk. Drëkòwanié ze sztandardowégò wińdzeniô bãdze "
"wëłączoné."

#: printwrapper.cpp:193
#, kde-format
msgid ""
"When using '--nodialog', you must at least specify one file to print or use "
"the '--stdin' flag."
msgstr ""
"Czédë brëkùjesz '--nodialog', nót je òtaksowac przënômni jeden lopk do drëkù "
"abò brëkòwac òptacëji '--stdin'."

#: printwrapper.cpp:242
#, kde-format
msgid "The specified printer or the default printer could not be found."
msgstr "Nie je nalazłi pòdóny drëkër ani domëszlny drëkër."

#: printwrapper.cpp:244
#, kde-format
msgid "Operation aborted."
msgstr "Òperacëjô òprzestónô."

#: printwrapper.cpp:274
#, kde-format
msgid "Unable to construct the print dialog."
msgstr "Nie je mòżno òtemknąc òkna drëkù."

#: printwrapper.cpp:315
#, kde-format
msgid "Multiple files (%1)"
msgstr "Wielorazowi lopczi (%1)"

#: printwrapper.cpp:322
#, kde-format
msgid "Nothing to print."
msgstr "Nick nie mô do drëkù."

#: printwrapper.cpp:347
#, kde-format
msgid "Unable to open temporary file."
msgstr "Nie je mòżno òtemknąc timczasowégò lopkù."

#: printwrapper.cpp:362
#, kde-format
msgid "Stdin is empty, no job sent."
msgstr "Wéńdzenié je pùsté, nie wësłóno niżódny robòtë."

#: printwrapper.cpp:374
#, kde-format
msgid "Unable to copy file %1."
msgstr "Nie mòże skòpijowac lopkù %1."

#: printwrapper.cpp:391
#, kde-format
msgid "Error while printing files"
msgstr "Fela òbczas drëkòwaniô lopkù"

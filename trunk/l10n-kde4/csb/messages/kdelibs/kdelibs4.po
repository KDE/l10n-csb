#: kdeui/findreplace/kfinddialog.cpp:223
msgid ""
"<qt>If enabled, any occurrence of <code><b>\\N</b></code>, where <code><b>N</"
"b></code> is an integer number, will be replaced with the corresponding "
"capture (\"parenthesized substring\") from the pattern.<p>To include (a "
"literal <code><b>\\N</b></code> in your replacement, put an extra backslash "
"in front of it, like <code><b>\\\\N</b></code>.</p></qt>"
msgstr ""
"<qt>Jeżlë na òptacëjô je włączonô, kòżdé wëstãpienié <code><b>\\N</b></"
"code>, dze <code><b>N</b></code> je całowną wielëną, òstanie zastãpioné "
"pasownym wëslôwiã w klamrach z mùstra.<p>Bë ùżëc prôwdzëwegò <code><b>\\N</"
"b></code> w zastãpùjącym nôdpisë, nót je wstôwic przed nim dodôwny sztriszk "
"na szôrc na nen ôrt: <code><b>\\\\N</b></code>.</p></qt>"


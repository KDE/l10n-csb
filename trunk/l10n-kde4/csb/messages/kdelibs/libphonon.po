#: audiooutput.cpp:304
#, kde-format
msgid ""
"<html>The audio playback device <b>%1</b> does not work.<br/>Falling back to "
"<b>%2</b>.</html>"
msgstr ""
"<html>Grôjącé ùrządzenié <b>%1</b> nie fùnkcjonëje.<br/>Przëdchòdzy "
"doprowôdzanié nazôd <b>%2</b>.</html>"

#: audiooutput.cpp:309
#, kde-format
msgid ""
"<html>Switching to the audio playback device <b>%1</b><br/>which just became "
"available and has higher preference.</html>"
msgstr ""
"<html>Przëchòdzy przełãczanié do grającégò ùrządzeniô <b>%1</b><br/> "
"jaczé prawie terô stało sã przistãpné ë je preferowóné.</html>"

#: audiooutput.cpp:312
#, kde-format
msgid "Revert back to device '%1'"
msgstr "Przëwrócë ùrządzenié '%1'"


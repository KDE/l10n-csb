#: interfaces/ktexteditor/kcm_ktexteditor.desktop:1
msgctxt "Name"
msgid "Embedded Text Editor"
msgstr "Òbsôdzony editora tekstu"

#: interfaces/ktexteditor/kcm_ktexteditor.desktop:77
msgctxt "Comment"
msgid ""
"The text editor service provides applications with a text viewer and editor. "
"KDE applications that provide text editing facilities should use this "
"service."
msgstr ""
"Ùsłëżnota tekstowegò editorë zezwôlô aplikaceją na przezéranié ë edicejã "
"tekstów. Programë KDE, jaczé ùprzistãpniają nã edicëjną fùnkcëjã, mają "
"brëkòwac ti ùsłëżnotë."

#: interfaces/ktexteditor/ktexteditor.desktop:5
msgctxt "Comment"

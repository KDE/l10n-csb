msgctxt "Name"
msgid "Insert File"
msgstr "Wstôwi lopk"

#: kate/plugins/insertfile/ktexteditor_insertfile.desktop:25
msgctxt "Comment"
msgid "Insert any readable file at cursor position"
msgstr "Wstôwiô zamkłosc lopkù przë kursorze"


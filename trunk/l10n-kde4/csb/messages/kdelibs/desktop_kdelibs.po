msgctxt "Name"
msgid "Data tools"
msgstr "Nôrzãdze pòdôwków"

#: kate/plugins/kdatatool/ktexteditor_kdatatool.desktop:25
msgctxt "Comment"
msgid "Enable data tools like thesaurus and spell check (if installed)"

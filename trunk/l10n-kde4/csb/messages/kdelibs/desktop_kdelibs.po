msgstr "Aùtomatné wstôwianié załóżków"

#: kate/plugins/autobookmarker/ktexteditor_autobookmarker.desktop:24
msgctxt "Comment"
msgid "Set bookmarks on lines matching a pattern when documents are loaded"

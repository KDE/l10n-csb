msgstr "Serwer wëmôgô %1, jaczi nie je przistãpny."

#: kio/global.cpp:364
msgid "Access to restricted port in POST denied."
msgstr "Felënk przistãpù do òrańczonegò pòrtu w POST."

#: kio/global.cpp:367
#, kde-format
msgid ""
"Unknown error code %1\n"
"%2\n"

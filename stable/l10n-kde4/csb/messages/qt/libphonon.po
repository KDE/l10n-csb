#: volumeslider.cpp:39 volumeslider.cpp:55 volumeslider.cpp:180
#: volumeslider.cpp:195
#, qt-format
msgid "Volume: %1%"
msgstr "Głosnosc: %1%"

#: volumeslider.cpp:41 volumeslider.cpp:57 volumeslider.cpp:109
#, qt-format
msgid ""
"Use this slider to adjust the volume. The leftmost position is 0%, the "
"rightmost is %1%"
msgstr ""
"Brëkùje suwôka bë zmienic głosnoc. Maksymalné pòłóżenié z lewi starnë to 0%, "
"a z prawi %1%"

#: volumeslider.cpp:175
msgid "Muted"
msgstr "Wëcëszony"

#: audiooutput.cpp:346
#, qt-format
msgid ""
"<html>The audio playback device <b>%1</b> does not work.<br/>Falling back to "
"<b>%2</b>.</html>"
msgstr ""
"<html>Grôjącé ùrządzenié <b>%1</b> nie fùnkcjonëje.<br/>Przëdchòdzy "
"doprowôdzanié nazôd <b>%2</b>.</html>"

#: audiooutput.cpp:354
#, qt-format
msgid ""
"<html>Switching to the audio playback device <b>%1</b><br/>which just became "
"available and has higher preference.</html>"
msgstr ""
"<html>Przëchòdzy przełãczanié do grającégò ùrządzeniô <b>%1</b><br/> jaczé "
"prawie terô stało sã przistãpné ë je preferowóné.</html>"

#: audiooutput.cpp:357
#, qt-format
msgid "Revert back to device '%1'"
msgstr "Przëwrócë ùrządzenié '%1'"


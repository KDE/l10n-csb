#: kcmtrash.cpp:158 kcmtrash.cpp:256
msgid " day"
msgid_plural " days"
msgstr[0] " dzéń"
msgstr[1] " dni"
msgstr[2] " dniów"

#: kcmtrash.cpp:247
msgid "Delete files older than:"
msgstr "Rëmôj lopczi stôrszé jakno: "

#: kcmtrash.cpp:249
msgctxt "@info:whatsthis"
msgid ""
"<para>Check this box to allow <b>automatic deletion</b> of files that are "
"older than the value specified. Leave this disabled to <b>not</b> "
"automatically delete any items after a certain timespan</para>"
msgstr ""
"<para>Nacéchùjë nã kastkã abë zezwòlëc na <b>aùtomatné rëmanié</b> lopków co "
"są stôrszé jakno òzakòwónô wôrtnota . Òstawi ni nacéchòwóné dlô <b>ni</b> "
"aùtoamtnegò rëmaniô kòżdëch zamkłosców pò dónym czasu</para>"

#: kcmtrash.cpp:258
msgctxt "@info:whatsthis"
msgid ""
"<para>Set the number of days that files can remain in the trash. Any files "
"older than this will be automatically deleted.</para>"
msgstr ""
"<para>Nastôwi wielënã dni przez chtërné mają bëc trzëmóné lopczi w kòszu. "
"Wszëtczé stôrszé lopczi bãdą aùtomatno rëmniãté.</para>"

#: kcmtrash.cpp:266
msgid "Limit to maximum size"
msgstr "Limit do maksymalny miarë"

#: kcmtrash.cpp:268
msgctxt "@info:whatsthis"
msgid ""
"<para>Check this box to limit the trash to the maximum amount of disk space "
"that you specify below. Otherwise, it will be unlimited.</para>"
msgstr ""
"<para>Nacéchùjë na kastkã abë nastôwic limit kòsza, zezwôlający na wiôlgòsc "
"jegò placu na diskù. Jinaczi bãdze òn bez ògrańczeniô.</para>"

#: kcmtrash.cpp:286
msgctxt "@info:whatsthis"
msgid ""
"<para>This is the maximum percent of disk space that will be used for the "
"trash.</para>"
msgstr "<para>Maksymalnô procentowô wiôlgòta placu na diskù dlô kòsza.</para>"

#: kcmtrash.cpp:291
msgctxt "@info:whatsthis"
msgid ""
"<para>This is the calculated amount of disk space that will be allowed for "
"the trash, the maximum.</para>"
msgstr "<para>To je dobëtô maksymalnô miara placu zezwòlonô dlô kòsza.</para>"

#: kcmtrash.cpp:294
msgid "Maximum size:"
msgstr "Maksymalna miara:"

#: kcmtrash.cpp:296
msgid "When limit reached:"
msgstr "Jak je doszłé do limitu:"

#: kcmtrash.cpp:300
msgid "Warn Me"
msgstr "Dôj mie òstrzegã"

#: kcmtrash.cpp:301
msgid "Delete Oldest Files From Trash"
msgstr "Rëmôj nôstôrszé lopczi z kòsza"

#: kcmtrash.cpp:302
msgid "Delete Biggest Files From Trash"
msgstr "Rëmôj nôwikszé lopczi z kòsza"

#: kcmtrash.cpp:304
msgctxt "@info:whatsthis"
msgid ""
"<para>When the size limit is reached, it will prefer to delete the type of "
"files that you specify, first. If this is set to warn you, it will do so "
"instead of automatically deleting files.</para>"
msgstr ""
"<para>Jeżlë je dobëti limit miarë, to rëmniãti bãdze specyficzny ôrt lopka. "
"Jeżlë je to nastôwioné na òstrzéganié, to pòkôże sã òstrzéga w placu "
"aùtomatnégò rëmniãcô.</para>"

#: kio_trash.cpp:92 kio_trash.cpp:155 kio_trash.cpp:308 kio_trash.cpp:340
#: kio_trash.cpp:506 kio_trash.cpp:518
#, kde-format
msgid "Malformed URL %1"
msgstr "Zmiłkòwi URL %1"

#: kio_trash.cpp:111
#, kde-format
msgid ""
"The directory %1 does not exist anymore, so it is not possible to restore "
"this item to its original location. You can either recreate that directory "
"and use the restore operation again, or drag the item anywhere else to "
"restore it."
msgstr ""
"Kataloga %1 ju nié dô, tedë nie jë mòżlewé doprowadzenié negò elementu do "
"jegò apartny lokalizacëji. Mòżesz równak ùsôdzëc nen katalog ë brëkòwac "
"òptacëji doprowadzeniô nazôd, abò przecygnąc nen element dze jindze abë gò "
"przëwrócëc."

#: kio_trash.cpp:140 kio_trash_win.cpp:228
msgid "This file is already in the trash bin."
msgstr "Nen lopk je w kòszu."

#: kio_trash.cpp:228 kio_trash_win.cpp:252
msgid "Internal error in copyOrMove, should never happen"
msgstr "Bënowô fela w dzéjaniu copyOrMove - to nié mòże sã przëtrôfic"

#: kio_trash_win.cpp:241
msgid "not supported"
msgstr "nie wspieróné"

#: ktrash.cpp:32
msgid "ktrash"
msgstr "ktrash"

#: ktrash.cpp:34
msgid ""
"Helper program to handle the KDE trash can\n"
"Note: to move files to the trash, do not use ktrash, but \"kioclient move "
"'url' trash:/\""
msgstr ""
"Pòmòcnô programa do òbsłużenkùi kòsza KDE.\n"
"Bôczënk: abë przeniesc lopczi z kòsza, nie brëkùjë ktrash, le pòlétu "
"\"kioclient move 'url' trash:/\""

#: ktrash.cpp:38
msgid "Empty the contents of the trash"
msgstr "Rëmôj zamkłosc kòsza"

#: ktrash.cpp:40
msgid "Restore a trashed file to its original location"
msgstr "Przëwrócë lopk z kòsza do jegò apartnegò pòłóżeniô"

#: ktrash.cpp:42
msgid "Ignored"
msgstr "Ignorowóny"

#: trashimpl.cpp:1127
msgid ""
"The trash has reached its maximum size!\n"
"Cleanup the trash manually."
msgstr ""
"Kòsz dobëł swòja maksymalną miarã!\n"
"Wëczëszczë kòsz rãczno."

#: trashimpl.cpp:1138
msgid "The file is too large to be trashed."
msgstr "Nen lopk je za wiôldżi abë gò przesënąc do kòsza."


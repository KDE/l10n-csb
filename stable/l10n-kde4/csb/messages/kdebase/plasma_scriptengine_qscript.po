#, kde-format
msgid "Authorization for required extension '%1' was denied."
msgstr "Aùtorizacëjô dlô wëmôgónegò rozszérzeniô '%1' òsta pòcësniãtô."

#: simplejavascriptapplet.cpp:619
msgid "dataEngine() takes one argument"
msgstr "dataEngine() mùszi miec ni mni jakno jeden argùment"


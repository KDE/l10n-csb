#: javascriptdataengine.cpp:95
msgid "setData() takes at least two arguments"
msgstr "setData() mùszi miec nie mni jakno dwa argùmentë"

#: javascriptdataengine.cpp:126
msgid "Could not extract the DataEngineObject"
msgstr "Ni mòże wëdobëc DataEngineObject"

#: javascriptdataengine.cpp:130
msgid "Could not extract the DataEngine"
msgstr "Ni mòże wëdobëc DataEngine"

#: javascriptdataengine.cpp:140
msgid "removeAllData() takes at least one argument (the source name)"
msgstr "removeAllData() mùszi miec ni mni jakno jeden argùment (miono zdroju)"

#: javascriptdataengine.cpp:158
msgid "removeData() takes at least two arguments (the source and key names)"
msgstr ""
"removeData() mùszi miec ni mni jakno dwa argumentë (miona zdroju ë klucza)"

#: simplejavascriptapplet.cpp:130
#, kde-format
msgid ""
"Script failure on line %1:\n"
"%2"
msgstr ""
"Fela skriptu w réżce %1:\n"
"%2"


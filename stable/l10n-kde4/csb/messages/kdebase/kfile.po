#: fileprops.cpp:230
msgid "kfile"
msgstr "kfile"

#: fileprops.cpp:231
msgid "A commandline tool to read and modify metadata of files."
msgstr "Nôrzãdze rézë pòlétów do czëtaniô a mòdifikòwaniô meta pòdôwków lopków."

#: fileprops.cpp:232
msgid "(c) 2002, Carsten Pfeiffer"
msgstr "(c) 2002, Carsten Pfeiffer"

#: fileprops.cpp:236
msgid "Carsten Pfeiffer"
msgstr "Carsten Pfeiffer"

#: fileprops.cpp:245
msgid "Do not print the mimetype of the given file(s)"
msgstr "Nie wëpisujë ôrtów mime nëch lopków"

#: fileprops.cpp:247
msgid "List all supported metadata keys."
msgstr "Lësta wszëtczich wspiérónëch kluczy pòdôwków meta."

#: fileprops.cpp:249
msgid "List all metadata keys which have a value in the given file(s)."
msgstr "Lësta wszëtczich kluczy pòdôwków meta jaczé mają wôrtnotã w dónëch lopkach."

#: fileprops.cpp:252
msgid ""
"Do not print a warning when more than one file was given and they do not all "
"have the same mimetype."
msgstr "Nie wëpisujë òstrzégów czej wicy jak jeden lopk òstôł pòdóny ë ni mają nëch sómëch ôrtów mime."

#: fileprops.cpp:255
msgid "Prints all metadata values, available in the given file(s)."
msgstr "Wëpisuje wszëtczé wôrtnotë pòdôwków meta, przëstãpné w pòdónëch lopkach."

#: fileprops.cpp:257
msgid ""
"Opens a KDE properties dialog to allow viewing and modifying of metadata of "
"the given file(s)"
msgstr "Òtmëkô òkno swòjiznë KDE bë òbaczëc ë zmienic pòdôwczi meta pòdónëch lopków"

#: fileprops.cpp:259
msgid ""
"Prints the value for 'key' of the given file(s). 'key' may also be a comma-"
"separated list of keys"
msgstr "Wëpisuje wôrtotã 'key' pòdónégò lopka. 'key' mòże bëc téż lëstą kluczy òddzélonëch kòmą"

#: fileprops.cpp:261
msgid ""
"Attempts to set the value 'value' for the metadata key 'key' for the given "
"file(s)"
msgstr "Próbùjë ùstawic wôrtnotã 'value' dlô kluczy pòdôwkó meta 'key' dlô pòdónëch lopków"

#: fileprops.cpp:263
msgid "The file (or a number of files) to operate on."
msgstr "Lopk (abò lëczba lopków) do òperowaniô."

#: fileprops.cpp:277
msgid "No files specified"
msgstr "Nie òstôł pòdóny niżóden lopk"

#: fileprops.cpp:297
msgid "Cannot determine metadata"
msgstr "Nimòże nalézc pòdôwków meta"

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "Michôł Òstrowsczi"


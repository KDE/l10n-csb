#: random.cpp:45
#, kde-format
msgid ""
"Usage: %1 [-setup] [args]\n"
"Starts a random screen saver.\n"
"Any arguments (except -setup) are passed on to the screen saver."
msgstr ""
"Brëkòwanié: %1 [-setup] [args]\n"
"Zrëszô kawlowi wëgaszôcz ekranu.\n"
"Jine argùmentë (króm -setup) sélóne są do wëgaszôcza ekranu."

#: random.cpp:52
msgid "Start a random KDE screen saver"
msgstr "Zrëszë kawlowi wëgaszôcz ekranu"

#: random.cpp:67
msgid "Random screen saver"
msgstr "Kawlowi wëgaszôcz ekranu"

#: random.cpp:73
msgid "Setup screen saver"
msgstr "Kònfigùracëjô wëgaszôcza ekranu"

#: random.cpp:75
msgid "Run in the specified XWindow"
msgstr "Zrëszë w wëbrónym òknie XWindow"

#: random.cpp:77
msgid "Run in the root XWindow"
msgstr "Zrëszë w przédnym òknie XWindow"

#: random.cpp:195
msgid "Setup Random Screen Saver"
msgstr "Kònfigùracëjô kawlowégò wëgaszôcza ekranu"

#: random.cpp:203
msgid "Use OpenGL screen savers"
msgstr "Brëkùjë wëgaszôczów OpenGL"

#: random.cpp:206
msgid "Use screen savers that manipulate the screen"
msgstr "Brëkùjë wëgaszôczów, chtërné wëzwëskiwùją aktualny òbrôz ekranu"

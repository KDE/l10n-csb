#: devicenotifier.cpp:252
#, kde-format
msgid "1 action for this device"
msgid_plural "%1 actions for this device"
msgstr[0] "1 dzejanié dlô tegò ùrządzeniô"
msgstr[1] "%1 dzejania dlô tegò ùrządzeniô"
msgstr[2] "%1 dzejaniół dlô tegò ùrządzeniô"

#: devicenotifier.cpp:451
msgid ""
"Cannot unmount the device.\n"
"One or more files on this device are open within an application."
msgstr ""
"Nié mòże òdmòntowac ùrządzenia.\n"
"Jeden abò wicy lopków na tim ùrządzeniô je òtemkłi w aplikacëji."

#: devicenotifier.cpp:466
msgid ""
"Cannot eject the disc.\n"
"One or more files on this disc are open within an application."
msgstr ""
"Nié mòże wësënąc diskù.\n"
"Jeden abò wicy lopków na tim diskù je òtemkłi w aplikacëji."


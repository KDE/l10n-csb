#: kdialog.cpp:679
msgid "Progress bar dialog, returns a D-Bus reference for communication"
msgstr "Òkno z sztrépkã pòkroków, zwracô identifikatorã D-Bus do kòmùnikacëji"

#: kdialog.cpp:680
msgid "Color dialog to select a color"
msgstr "Dialogòwi òkno do wëbiérkù farwë"

#: kdialog.cpp:682
msgid "Dialog title"
msgstr "Titel òkna"

#: kdialog.cpp:683
msgid "Default entry to use for combobox, menu and color"
msgstr "Domëslne wińdzenié dlô rozwijnëch lëstew, menu ë farwë"

#: kdialog.cpp:684
msgid ""
"Allows the --getopenurl and --getopenfilename options to return multiple "
"files"
msgstr ""
"Pòzwòlô na wëbiérk lopkù w wielu òptacëjach --getopenurl ë --getopenfilename"

#: kdialog.cpp:685
msgid ""
"Return list items on separate lines (for checklist option and file open with "
"--multiple)"
msgstr ""
"Zwrócë elementë lëstë w pòsobnëch réżkach (dlô lopków ótmekanëch òptacëją --"
"multiple a téż dlô lëstë òptacëji)"

#: kdialog.cpp:686
msgid "Outputs the winId of each dialog"
msgstr "Zwraca identifikatorã kòżdegò òkna"

#: kdialog.cpp:687
msgid "Makes the dialog transient for an X app specified by winid"
msgstr "Zrzëszô dialogòwi òkno z programã X ò gwësny identifikatorze"

#: kdialog.cpp:688
msgid ""
"Config file and option name for saving the \"do-not-show/ask-again\" state"
msgstr ""
"Kònfigùracëjowi lopk ë miono òptacëji do zapisënkù sztatusa \"Nie pòkazëjë/"
"pëtôj znowa\""

#: kdialog.cpp:689
msgid "Arguments - depending on main option"
msgstr "Argùmentë - zanôléżą òd przédny òptacëji"


#: kwriteapp.cpp:37 kwritemain.cpp:500
msgid ""
"A KDE text-editor component could not be found.\n"
"Please check your KDE installation."
msgstr ""
"Ni mòże nalezc kòmpònenta editorë tekstu KDE.\n"
"Proszã sprôwdzë swòją instalacëjã KDE."

#: kwriteapp.cpp:145
#, kde-format
msgid ""
"The file '%1' could not be opened: it is not a normal file, it is a folder."
msgstr ""
"Lopk '%1' ni mòże òstac òtemkniãti: to nie je zwëkòwi lopk, to katalog."

#: kwritemain.cpp:149
msgid "Use this command to close the current document"
msgstr "Brëkùjë tegò pòlétu do zamkniãcô biéżnegò dokùmentu"

#: kwritemain.cpp:153
msgid "Use this command to create a new document"
msgstr "Brëkùjë tegò pòlétu do ùsôdzeniô nowégò dokùmentu"

#: kwritemain.cpp:155
msgid "Use this command to open an existing document for editing"
msgstr "Brëkùjë tegò pòlétu do òtemkniãcô dokùmentu, jaczi ju je, do edicëji"

#: kwritemain.cpp:159
msgid ""
"This lists files which you have opened recently, and allows you to easily "
"open them again."
msgstr ""
"Na lësta zamëkô w se dokùmentë jaczé môsz slédno òtemkłé ë zezwôlu na "
"chùtczé jich òtemkniãcé."

#: kwritemain.cpp:163
msgid "&New Window"
msgstr "&Nowé òkno"

#: kwritemain.cpp:165
msgid "Create another view containing the current document"
msgstr "Ùsôdzô nowi wëzdrzatk biéżnegò dokùmentu"

#: kwritemain.cpp:168
msgid "Close the current document view"
msgstr "Zamëkô wëzdrzatk biéżnegò dokùmentu"

#: kwritemain.cpp:175
msgid "Use this command to show or hide the view's statusbar"
msgstr "Brëkùjë tegò pòlétu do wëskrzënianiô abò tacëniô listwë stónu"

#: kwritemain.cpp:177
msgid "Sho&w Path"
msgstr "&Wëskrzëni stegnã"

#: kwritemain.cpp:180
msgid "Show the complete document path in the window caption"
msgstr "Wëskrzëni całowną stegnã aktiwnegò dokùmnetu w titlowi listwie"

#: kwritemain.cpp:183
msgid "Configure the application's keyboard shortcut assignments."
msgstr "Kònfigùrëje skrodzënë klawiaturë dlô ti aplikacëji"

#: kwritemain.cpp:187
msgid "Configure which items should appear in the toolbar(s)."
msgstr "Kònfigùrëje jaczé knąpë mają sã wëskrzëniac w listwie nôrzãdzów."

#: kwritemain.cpp:190
msgid "&About Editor Component"
msgstr "Ò &kòmpònencé editorë"

#: kwritemain.cpp:199 kwritemain.cpp:562
#, kde-format

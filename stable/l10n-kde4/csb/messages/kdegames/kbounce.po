msgstr "Môsz wëczëszczoné wicy jak %1% planszë\n"

#: gamewidget.cpp:345
#, kde-format
msgid "%1 points: %2 points per remaining life\n"
msgstr "%1 pkt: pò %2 pkt na òstałé żëcé\n"


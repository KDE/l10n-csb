#: playfield.cpp:254
#, fuzzy
#| msgid ""
#| "Your opponent is using a pre-KDE4 version of KBattleship. Note that, "
#| "according to the rules enforced by old clients, ships cannot be placed "
#| "adjacent to one another."
msgid ""
"Your opponent is using a pre-KDE4 version of Naval Battle. Note that, "
"according to the rules enforced by old clients, ships cannot be placed "
"adjacent to one another."
msgstr ""
"Twój procëmnik brëkùjë pre-KDE4 wersëjã KÒkrãtów. Bôczë, że prawidła grë dlô "
"stôrszégò klienta, nie zezwôlają na ùkłôdanié òkrãtół przëlégających jeden "
"do drëdżégò."

#: playfield.cpp:267
msgid "Enemy has shot. Shoot now!"
msgstr "Procëmnik òddôł strzél. Strzélôj terô të!"

#: playfield.cpp:271
msgid "Waiting for enemy to shoot..."
msgstr "Żdanié na strzél procëmnika..."

#: playfield.cpp:280
msgid "Ships placed. Now shoot on the enemy field!"
msgstr "Òkrãté są na swòjich placach. Strzélôj terô na pòlu procëmnika!"

#: playfield.cpp:283
msgid "Waiting for other player to start the game..."
msgstr "Żdanié na zôczãcé grë przez drëdżegò grôcza..."

#: playfield.cpp:287
msgid "Waiting for other player to place his ships..."
msgstr "Żdanié na ùstôwienié òkrãtów przez procëmnika..."

#: playfield.cpp:296
msgid "Place your ships. Use the right mouse button to rotate them."
msgstr "Ùstôwi swòjé òkrãtë. Brëkùjë lewi knąpë mëszë bë je òbrócëc."


#: kpercentage.cpp:84
msgid "Number of tasks:"
msgstr "Lëczba zadaniów:"

#: kpercentage.cpp:85
msgid "Level:"
msgstr "Równiô:"

#: kpercentage.cpp:86
msgid "Choose an exercise type:"
msgstr "Wëbiérzë ôrt cwiczënków:"

#: kpercentage.cpp:94
#, no-c-format
msgid "x% &of ?? = y"
msgstr "x% &z ?? = y"

#: kpercentage.cpp:96
#, no-c-format
msgid "x% of &y = ??"
msgstr "x% z &y = ??"

#: kpercentage.cpp:98
#, no-c-format
msgid "??% o&f x = y"
msgstr "??% z &x = y"

#: kpercentage.cpp:99
msgid "??"
msgstr "??"

#: kpercentage.cpp:104
msgid "E&xit"
msgstr "Wiń&dzë"

#: kpercentage.cpp:108
msgid "Easy"
msgstr "Prostô"

#: kpercentage.cpp:109
msgid "Medium"
msgstr "Strzédnô"

#: kpercentage.cpp:110
msgid "Crazy"
msgstr "Super drãgô"

#: kpercentage.cpp:183
msgid "Exercises with base value omitted"
msgstr "Cwiczënczi z felëjącą pòdspòdlową wôrtnotą"

#: kpercentage.cpp:184
msgid "Exercises with percent value omitted"
msgstr "Cwiczënczi z felëjącą procentową wôrtnotą"

#: kpercentage.cpp:185
msgid "Exercises with percentage omitted"
msgstr "Cwiczënczi z felëjącym procentã"

#: kpercentage.cpp:186
msgid "Several exercise types in random"
msgstr "Czile kawlowëch cwiczënków"

#: kpercentage.cpp:187
msgid "Choose the number of exercises from 1 to 10."
msgstr "Wëbiérzë numer cwiczënkù òd 1 do 10."

#: kpercentage.cpp:188
msgid "Choose the level of difficulty."
msgstr "Wëbiérzë równiã drãgòscë."

#: kpercentage.cpp:189 kpercentage.cpp:200
msgid "Close KPercentage."
msgstr "Zamkni KPercentage."

#: kpercentage.cpp:190 kpercentage.cpp:201
msgid "Get some help."
msgstr "Pòmòc."

#: kpercentage.cpp:194
msgid ""
"Click here to start a sequence of exercises where the base value is omitted."
msgstr ""
"Wcësni tã knąpã bë nacząc seriã cwiczënków z felëjącą pòdspòdlową wôrtnotą."

#: kpercentage.cpp:195
msgid ""
"Click here to start a sequence of exercises where the percent value is "
"omitted."
msgstr ""
"Wcësni tã knąpã bë nacząc seriã cwiczënków z felëjącą procentową wôrtnotą."

#: kpercentage.cpp:196
msgid ""
"Click here to start a sequence of exercises where the percentage is omitted."
msgstr "Wcësni tã knąpã bë nacząc seriã cwiczënków z felëjącyma procentama."

#: kpercentage.cpp:197
msgid ""
"Click here to start a sequence of exercises where one value is omitted at "
"random."
msgstr "Wcësni tã knąpã bë nacząc seriã cwiczënków z felëjącą kawlową wôrtotą."

#: kpercentage.cpp:198
msgid "Here you can adjust the number of exercises from 1 to 10."
msgstr "Tuwò mòżesz wëbrac lëczbã cwiczënków òd 1 do 10."

#: kpercentage.cpp:199
msgid "Choose one of the levels <i>easy</i>, <i>medium</i>, and <i>crazy</i>."
msgstr ""
"Wëbiérzë jedną z równi <i>prostą</i>, <i>strzédną</i> abò <i>super drãgą</i>."

#: main.cpp:30
msgid "A program to improve your skills in calculating with percentages"
msgstr "Programa do zwikszeniô sprôwnoscë w rachòwanim procentów"


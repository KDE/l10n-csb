msgstr "Robòta nr. MM:"

#: kpercentmain.cpp:130
msgid "You got MM of MM."
msgstr "Môsz MM z MM."

#: kpercentmain.cpp:207
msgid "Number of managed exercises"
msgstr "Lëczba skùńczonëch cwiczënków"

#: kpercentmain.cpp:208
msgid "Relation of right to wrong inputs"
msgstr "Propòrcjô òdpòwiesców dobrich do lëchich"

#: kpercentmain.cpp:209
msgid "Check your answer"
msgstr "Sprôwdzë swòją òdpòwiesc"

#: kpercentmain.cpp:210
msgid "Back to the main window"
msgstr "Jidzë nazôd do przédnégò òkna"

#: kpercentmain.cpp:249
#, kde-format
msgid "You got %1 of %2 exercises."
msgstr "Môsz zrobioné %1 z %2 cwiczënków"


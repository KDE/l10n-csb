#: main.cpp:247
msgid ""
"Starts 'wm' in case no other window manager is \n"
"participating in the session. Default is 'kwin'"
msgstr ""
"Zrësziwô 'wm' eżle niżóden jinszi menadżer òknów \n"
"nie je aktiwny w ti sesëji. Domëslny je 'kwin'"


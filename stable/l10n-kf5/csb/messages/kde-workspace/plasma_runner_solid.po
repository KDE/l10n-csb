#: devicewrapper.cpp:144 devicewrapper.cpp:160
msgid "Eject medium"
msgstr "Wësënie medium"

#: devicewrapper.cpp:148
msgid "Mount the device"
msgstr "Zamòntëjë ùrządzenié"

#: devicewrapper.cpp:150
msgid "Unmount the device"
msgstr "Òdmòntëjë ùrządzenié"

#: devicewrapper.cpp:154
msgctxt ""
"Unlock the encrypted container; will ask for a password; partitions inside "
"will appear as they had been plugged in"
msgid "Unlock the container"
msgstr "Zablokùjë kònténer"

#: devicewrapper.cpp:156
msgctxt ""
"Close the encrypted container; partitions inside will disappear as they had "
"been unplugged"
msgid "Lock the container"
msgstr "Òdblokùjë kònténer"

#: solidrunner.cpp:47
msgid "Finds devices whose name match :q:"
msgstr "Nalézë ùrządzenia z mionã pasownym do :q:"

#: solidrunner.cpp:49 solidrunner.cpp:137
msgctxt "Note this is a KRunner keyword"
msgid "device"
msgstr "ùrządzenié"

#: solidrunner.cpp:50
msgid "Lists all devices and allows them to be mounted, unmounted or ejected."
msgstr ""
"Wëskrzëniô wszëtczé ùrządzenia ë zezwôlô na jich mòntowanié, òdmòntowanié "
"abò wësëwanié."

#: solidrunner.cpp:51 solidrunner.cpp:143
msgctxt "Note this is a KRunner keyword"
msgid "mount"
msgstr "zamòntëjë"

#: solidrunner.cpp:52
msgid "Lists all devices which can be mounted, and allows them to be mounted."
msgstr ""
"Wëskrzëniô wszëtczé ùrządzenia, chtërné mògą bëc mòntowóné ëzezwôlô na jich "
"mòntowanié."

#: solidrunner.cpp:53 solidrunner.cpp:156
msgctxt "Note this is a KRunner keyword"
msgid "unlock"
msgstr ""

#: solidrunner.cpp:54
#, fuzzy
msgid ""
"Lists all encrypted devices which can be unlocked, and allows them to be "
"unlocked."
msgstr ""
"Wëskrzëniô wszëtczé ùrządzenia, chtërné mògą bëc òdmòntowóné ëzezwôlô na "
"jich òdmòntowanié."

#: solidrunner.cpp:55 solidrunner.cpp:147
msgctxt "Note this is a KRunner keyword"
msgid "unmount"
msgstr "òdmòntëjë"

#: solidrunner.cpp:56
msgid ""
"Lists all devices which can be unmounted, and allows them to be unmounted."
msgstr ""
"Wëskrzëniô wszëtczé ùrządzenia, chtërné mògą bëc òdmòntowóné ëzezwôlô na "
"jich òdmòntowanié."

#: solidrunner.cpp:57 solidrunner.cpp:161
msgctxt "Note this is a KRunner keyword"
msgid "lock"
msgstr ""

#: solidrunner.cpp:58
#, fuzzy
msgid ""
"Lists all encrypted devices which can be locked, and allows them to be "
"locked."
msgstr ""
"Wëskrzëniô wszëtczé ùrządzenia, chtërné mògą bëc mòntowóné ëzezwôlô na jich "
"mòntowanié."

#: solidrunner.cpp:60 solidrunner.cpp:151
msgctxt "Note this is a KRunner keyword"
msgid "eject"
msgstr "wësënie"

#: solidrunner.cpp:61
msgid "Lists all devices which can be ejected, and allows them to be ejected."
msgstr ""
"Wëskrzëniô wszëtczé ùrządzenia, chtërné mògą bëc wësëniãté ëzezwôlô na jich "
"wësëwanié."

